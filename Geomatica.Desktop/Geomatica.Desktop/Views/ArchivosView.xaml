<UserControl x:Class="Geomatica.Desktop.Views.ArchivosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Geomatica.Desktop.Views"
             xmlns:vm="clr-namespace:Geomatica.Desktop.ViewModels"
             xmlns:models="clr-namespace:Geomatica.Desktop.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════ Barra de ruta (breadcrumb) y Acciones ══════ -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="True">
                <!-- Botón Arriba a la izquierda (permite soltar para mover a la carpeta superior) -->
                <Button x:Name="btnArriba" Content="⬆  Arriba" Command="{Binding ArribaCommand}"
                        Style="{StaticResource ToolbarButton}" Width="85" DockPanel.Dock="Left"
                        ToolTip="Subir al nivel superior de carpetas (o arrastre un archivo aquí para moverlo arriba)"
                        AllowDrop="True" Drop="BtnArriba_Drop" DragOver="BtnArriba_DragOver" DragLeave="BtnArriba_DragLeave"/>
                <Rectangle Width="1" Height="20" Fill="{StaticResource SeparatorBrush}" Margin="8,0" DockPanel.Dock="Left"/>
                <TextBlock Text="Ruta:" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           FontFamily="{StaticResource AppFont}" Margin="0,0,6,0" DockPanel.Dock="Left"/>

                <!-- Acciones derecha: Filtro de Tipo, Buscador y Botón Extender -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <TextBlock Text="Tipo:" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               FontFamily="{StaticResource AppFont}" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding ExtensionesDisponibles}"
                              SelectedItem="{Binding FiltroExtensionSeleccionado, Mode=TwoWay}"
                              DisplayMemberPath="DisplayTexto"
                              Width="140" VerticalAlignment="Center"
                              ToolTip="Filtrar y listar archivos por extensión en todo el proyecto"
                              Margin="0,0,8,0" Padding="4,2"/>
                    <TextBlock Text="Buscar:" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               FontFamily="{StaticResource AppFont}" Margin="0,0,6,0"/>
                    <Grid Width="130" Margin="0,0,4,0">
                        <TextBox Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Padding="6,3,22,3" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding LimpiarBusquedaCommand}"
                                Style="{StaticResource ClearButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,3,0" Width="18" Height="18" FontSize="9"
                                Visibility="{Binding HasBusquedaTexto, Converter={StaticResource BoolToVis}}"
                                ToolTip="Limpiar búsqueda"/>
                    </Grid>
                    <Rectangle Width="1" Height="20" Fill="{StaticResource SeparatorBrush}" Margin="8,0"/>
                    <Button Content="{Binding ExtenderBotonTexto}" Command="{Binding ToggleExtenderCommand}"
                            Style="{StaticResource ToolbarButton}" ToolTip="{Binding ExtenderBotonTooltip}"
                            Padding="8,3" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Path takes remaining space -->
                <TextBlock Text="{Binding RutaActual, TargetNullValue='(raíz del proyecto)'}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource AppFont}"
                           ToolTip="{Binding RutaActual}"/>
            </DockPanel>
        </Border>

        <!-- ══════ File list with GridView columns ══════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Banner de Filtro Activo por Extensión -->
            <Border Grid.Row="0" Background="#E8F0FE" BorderBrush="#B8D4FE" BorderThickness="0,0,0,1"
                    Padding="10,6" Visibility="{Binding IsFiltradoPorExtension, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button Content="✕ Quitar filtro" Command="{Binding LimpiarFiltroExtensionCommand}"
                            DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}"
                            Foreground="#174EA6" FontWeight="SemiBold" Padding="8,2" FontSize="11.5"
                            ToolTip="Restablecer navegación habitual por carpetas"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔎 " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BannerFiltroTexto}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#174EA6" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ListView Grid.Row="1" x:Name="listViewArchivos"
                      ItemsSource="{Binding Items}"
                      MouseDoubleClick="ListView_MouseDoubleClick"
                      ContextMenuOpening="ListView_ContextMenuOpening"
                      PreviewMouseLeftButtonDown="ListView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="ListView_PreviewMouseMove"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      BorderThickness="0" Background="White"
                      FontFamily="{StaticResource AppFont}"
                      AllowDrop="True" Drop="ListView_Drop" DragOver="ListView_DragOver" DragLeave="ListView_DragLeave"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <!-- Atajos de teclado para operaciones de archivos -->
                <ListView.InputBindings>
                    <KeyBinding Key="F2" Command="{Binding RenombrarCommand}"/>
                    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}"/>
                    <KeyBinding Key="Delete" Command="{Binding EliminarCommand}"/>
                    <KeyBinding Modifiers="Control" Key="C" Command="{Binding CopiarCommand}"/>
                    <KeyBinding Modifiers="Control" Key="X" Command="{Binding CortarCommand}"/>
                    <KeyBinding Modifiers="Control" Key="V" Command="{Binding PegarCommand}"/>
                    <KeyBinding Key="Return" Command="{Binding AbrirCommand}"/>
                </ListView.InputBindings>

                <!-- Menú contextual para clic derecho -->
                <ListView.ContextMenu>
                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                        <!-- Encabezado con el nombre del elemento cuando está seleccionado -->
                        <MenuItem Header="{Binding NombreSeleccionado}" IsEnabled="False" FontWeight="Bold"
                                  Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"/>
                        <Separator Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"/>

                        <!-- Acciones primarias de apertura -->
                        <MenuItem Header="🗺️  Cargar en Mapa / Visor" Command="{Binding AbrirEnMapaCommand}"
                                  Visibility="{Binding IsFormatoMapaSeleccionado, Converter={StaticResource BoolToVis}}"
                                  FontWeight="SemiBold"/>
                        <MenuItem Header="👁️  Abrir con app externa" Command="{Binding AbrirCommand}"
                                  Visibility="{Binding IsArchivoSeleccionado, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="📂  Abrir carpeta" Command="{Binding AbrirCommand}"
                                  Visibility="{Binding IsCarpetaSeleccionada, Converter={StaticResource BoolToVis}}"
                                  FontWeight="SemiBold"/>
                        <MenuItem Header="⬇️  Descargar archivo..." Command="{Binding DescargarCommand}"
                                  Visibility="{Binding IsArchivoSeleccionado, Converter={StaticResource BoolToVis}}"/>

                        <Separator Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"/>

                        <!-- Operaciones de portapapeles y archivos -->
                        <MenuItem Header="✂️  Cortar / Mover" Command="{Binding CortarCommand}" InputGestureText="Ctrl+X"
                                  Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding PuedeModificarSeleccionado}"/>
                        <MenuItem Header="📋  Copiar" Command="{Binding CopiarCommand}" InputGestureText="Ctrl+C"
                                  Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="📥  Pegar" Command="{Binding PegarCommand}" InputGestureText="Ctrl+V"
                                  IsEnabled="{Binding CanPasteEfectivo}"/>

                        <Separator/>

                        <!-- Gestión: Renombrar y Eliminar -->
                        <MenuItem Header="✏️  Renombrar" Command="{Binding RenombrarCommand}" InputGestureText="F2"
                                  Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding PuedeModificarSeleccionado}"/>
                        <MenuItem Header="🗑️  Eliminar" Command="{Binding EliminarCommand}" InputGestureText="Supr"
                                  Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding PuedeModificarSeleccionado}"/>

                        <Separator Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"/>

                        <!-- Operaciones de ruta y sistema -->
                        <MenuItem Header="📋  Copiar ruta completa" Command="{Binding CopiarRutaCompletaCommand}"
                                  Visibility="{Binding IsElementoSeleccionado, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="📁  Mostrar en el Explorador de Windows" Command="{Binding MostrarEnExploradorCommand}"/>

                        <!-- Opciones de directorio / fondo vacío -->
                        <Separator/>
                        <MenuItem Header="➕  Subir archivo(s)..." Command="{Binding SubirCommand}"
                                  IsEnabled="{Binding PuedeEscribir}"/>
                        <MenuItem Header="📁  Nueva carpeta..." Command="{Binding NuevaCarpetaCommand}"
                                  IsEnabled="{Binding PuedeEscribir}"/>
                        <MenuItem Header="🔄  Actualizar" Command="{Binding RefrescarCommand}" InputGestureText="F5"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nombre" Width="230">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icono}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Ubicación" Width="170" DisplayMemberBinding="{Binding UbicacionRelativa}"/>
                        <GridViewColumn Header="Tamaño" Width="85" DisplayMemberBinding="{Binding TamanoTexto}"/>
                        <GridViewColumn Header="Modificado" Width="125" DisplayMemberBinding="{Binding FechaTexto}"/>
                        <GridViewColumn Header="Tipo" Width="70" DisplayMemberBinding="{Binding Extension}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,4"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListViewItem_PreviewMouseRightButtonDown"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- ══════ Panel Inspector de Geodatabase (.gdb) ══════ -->
            <Border Grid.Row="2" MaxHeight="220"
                    Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsGdbSeleccionada, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Inspector con Acciones Globales -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="📥 Cargar toda la GDB" Command="{Binding CargarTodaLaGdbCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                    ToolTip="Cargar todas las capas vectoriales y ráster de esta Geodatabase en el visor"/>
                            <Button Content="📍 Cargar capa seleccionada" Command="{Binding CargarCapaGdbSeleccionadaCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11"
                                    IsEnabled="{Binding HasCapaGdbSeleccionada}"
                                    ToolTip="Cargar únicamente la capa seleccionada en el visor"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗃️" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Capas internas de la Geodatabase:" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CapasGdbSeleccionada.Count, StringFormat='({0} elementos)'}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Width="70" Height="4" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsCargandoCapasGdb, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Lista scrolleable de capas internas -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding CapasGdbSeleccionada}"
                             SelectedItem="{Binding CapaGdbSeleccionada, Mode=TwoWay}"
                             BorderThickness="1" BorderBrush="#E2E8F0" Background="White"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="2,3">
                                    <!-- Insignia para Clases de Relación -->
                                    <Border x:Name="BadgeRel" DockPanel.Dock="Right" Background="#EDE7F6" BorderBrush="#D1C4E9"
                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="🔗 Relación 1:N" FontSize="9.5" Foreground="#673AB7" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Insignia para Tablas de Adjuntos -->
                                    <Border x:Name="BadgeAdj" DockPanel.Dock="Right" Background="#E0F2F1" BorderBrush="#80CBC4"
                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="📎 Fotos adjuntas" FontSize="9.5" Foreground="#00796B" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Botón de carga para Capas espaciales y Tablas regulares -->
                                    <Button x:Name="BtnCargarCapa" Content="Cargar" DockPanel.Dock="Right"
                                            Command="{Binding DataContext.AbrirCapaGdbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="10" Margin="6,0,0,0"
                                            ToolTip="Cargar esta capa en el mapa"/>

                                    <TextBlock Text="{Binding Icono}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding DetalleCompleto}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding EsRelacion}" Value="True">
                                        <Setter TargetName="BadgeRel" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="BtnCargarCapa" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EsAdjunto}" Value="True">
                                        <Setter TargetName="BadgeAdj" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="BtnCargarCapa" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Estado vacío -->
            <TextBlock Grid.RowSpan="3" Text="Seleccione un proyecto para ver sus archivos"
                       Style="{StaticResource EmptyStateText}"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <!-- Banner / Tarjeta de Acceso Restringido (UIS Active Directory) -->
            <Border Grid.RowSpan="3" Visibility="{Binding IsAccesoRestringido, Converter={StaticResource BoolToVis}}"
                    Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="8"
                    Padding="24,20" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="520">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Acceso Restringido" FontWeight="Bold" FontSize="16" Foreground="#C62828"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding MensajeRestriccion}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="#5F6368" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="Comuníquese con el administrador del dominio geomaticaad@uis.edu.co para solicitar los permisos de red requeridos."
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="11.5" Foreground="#757575" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════ Barra inferior de acciones ══════ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="10,8">
            <DockPanel LastChildFill="True">
                <!-- Mensaje de estado a la derecha -->
                <TextBlock Text="{Binding Estado}" DockPanel.Dock="Right" VerticalAlignment="Center"
                            FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                            FontFamily="{StaticResource AppFont}" Margin="12,0,0,0"
                            TextTrimming="CharacterEllipsis" MaxWidth="260"/>

                <!-- Botones de acción organizados horizontalmente con WrapPanel -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Grupo: Creación / Subida -->
                    <Button Content="➕ Subir" Command="{Binding SubirCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="10,5" Margin="0,2,4,2"
                            IsEnabled="{Binding PuedeEscribir}"
                            ToolTip="Subir uno o más archivos a la carpeta actual"/>
                    <Button Content="📁 Nueva Carpeta" Command="{Binding NuevaCarpetaCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,6,2" Padding="10,5"
                            IsEnabled="{Binding PuedeEscribir}"
                            ToolTip="Crear una nueva carpeta en la ubicación actual"/>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource SeparatorBrush}" Margin="2,2,6,2"/>

                    <!-- Grupo: Operaciones de Archivo -->
                    <Button Content="✂️ Cortar" Command="{Binding CortarCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,4,2" Padding="9,5"
                            IsEnabled="{Binding PuedeModificarSeleccionado}"
                            ToolTip="Cortar el elemento seleccionado (Ctrl+X)"/>
                    <Button Content="📋 Copiar" Command="{Binding CopiarCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,4,2" Padding="9,5"
                            IsEnabled="{Binding IsElementoSeleccionado}"
                            ToolTip="Copiar el elemento seleccionado (Ctrl+C)"/>
                    <Button Content="📥 Pegar" Command="{Binding PegarCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,4,2" Padding="9,5"
                            IsEnabled="{Binding CanPasteEfectivo}"
                            ToolTip="Pegar el elemento cortado o copiado en la ubicación actual (Ctrl+V)"/>
                    <Button Content="✏️ Renombrar" Command="{Binding RenombrarCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,6,2" Padding="9,5"
                            IsEnabled="{Binding PuedeModificarSeleccionado}"
                            ToolTip="Renombrar el elemento seleccionado (F2)"/>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource SeparatorBrush}" Margin="2,2,6,2"/>

                    <!-- Grupo: Visualización y SIG -->
                    <Button Content="🗺️ Ver en Mapa" Command="{Binding AbrirEnMapaCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,4,2" Padding="9,5"
                            IsEnabled="{Binding IsFormatoMapaSeleccionado}"
                            ToolTip="Cargar el archivo como capa en el visor de mapa"/>
                    <Button Content="👁️ Abrir con..." Command="{Binding AbrirCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,4,2" Padding="9,5"
                            IsEnabled="{Binding IsElementoSeleccionado}"
                            ToolTip="Abrir el archivo o carpeta con la aplicación predeterminada del sistema"/>
                    <Button Content="⬇️ Descargar" Command="{Binding DescargarCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,2,6,2" Padding="9,5"
                            IsEnabled="{Binding IsArchivoSeleccionado}"
                            ToolTip="Descargar una copia del archivo a otra ubicación del equipo"/>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource SeparatorBrush}" Margin="2,2,6,2"/>

                    <!-- Grupo: Peligro -->
                    <Button Content="🗑️ Eliminar" Command="{Binding EliminarCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,2,4,2" Padding="10,5"
                            IsEnabled="{Binding PuedeModificarSeleccionado}"
                            ToolTip="Eliminar el archivo o carpeta seleccionado (Supr)"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
