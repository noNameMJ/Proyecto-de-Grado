<UserControl x:Class="Geomatica.Desktop.Views.BarraFiltrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Width="300" MinWidth="250" MaxWidth="400" Background="{StaticResource PanelBrush}" 
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Filtros -->
                <RowDefinition Height="Auto"/>  <!-- Buscar button & progress -->
                <RowDefinition Height="Auto"/>  <!-- Resumen -->
                <RowDefinition Height="*"/>      <!-- Resultados (grows) -->
            </Grid.RowDefinitions>

            <!-- Encabezado Filtros -->
            <StackPanel Grid.Row="0" Margin="16,14,16,0">
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="Filtros" FontWeight="Bold" FontSize="16" 
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFont}"/>
                    <Button Content="Limpiar" Command="{Binding LimpiarFiltrosCommand}" 
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            FontSize="12"/>
                </DockPanel>

                <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,0,14"/>
            </StackPanel>

            <!-- Filtros -->
            <StackPanel Grid.Row="1" Margin="16,0,16,8">
                <!-- Palabra clave -->
                <TextBlock Text="Palabra clave" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PalabraClave, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                <!-- Rango temporal -->
                <TextBlock Text="Rango temporal" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Desde:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,4" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Desde}" Margin="0,0,4,4"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="✕" Command="{Binding LimpiarDesdeCommand}"
                            Style="{StaticResource ClearButton}"
                            VerticalAlignment="Center" Margin="0,0,0,4"
                            ToolTip="Limpiar fecha desde"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hasta:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Hasta}" Margin="0,0,4,0"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="✕" Command="{Binding LimpiarHastaCommand}"
                            Style="{StaticResource ClearButton}"
                            VerticalAlignment="Center"
                            ToolTip="Limpiar fecha hasta"/>
                </Grid>

                <!-- Departamento -->
                <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Departamentos}" 
                          SelectedItem="{Binding SelectedDepartamento, Mode=TwoWay}" 
                          DisplayMemberPath="Nombre" SelectedValuePath="Codigo" 
                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"/>

                <!-- Municipio -->
                <TextBlock Text="Municipio" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Areas}" 
                          SelectedItem="{Binding AreaInteres, Mode=TwoWay}" 
                          DisplayMemberPath="Nombre" SelectedValuePath="Codigo" 
                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
            </StackPanel>

            <!-- Botón buscar y Barra de Progreso -->
            <StackPanel Grid.Row="2" Margin="16,4,16,8">
                <Button Content="🔍  Buscar" Command="{Binding BuscarCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                        Padding="10,8"/>

                <!-- Indicador de carga animado -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsBuscando, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ModernProgressBar}" Margin="0,0,0,4"/>
                    <TextBlock Text="Buscando proyectos..." FontSize="11" FontStyle="Italic" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource AppFont}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Resumen -->
            <Border Grid.Row="3" Margin="16,0,16,8" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="4" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1">
                <ItemsControl ItemsSource="{Binding ResultadosResumen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource AppFont}" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Resultados -->
            <Grid Grid.Row="4" Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Resultados" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Right"
                            Visibility="{Binding ResultadosLista.Count, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ResultadosLista.Count, StringFormat='{}{0} disp.'}" 
                                   Style="{StaticResource StatusBadgeText}"/>
                    </Border>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding ResultadosLista}" 
                         SelectedItem="{Binding SelectedProyecto, Mode=TwoWay}" 
                         DisplayMemberPath="Titulo"
                         Style="{StaticResource ModernListBox}"/>

                <!-- Estado vacío -->
                <TextBlock Grid.Row="1" Text="No se encontraron proyectos.&#x0a;Ajuste los filtros e intente de nuevo."
                           Style="{StaticResource EmptyStateText}" FontSize="12"
                           Visibility="{Binding NoHayResultados, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
