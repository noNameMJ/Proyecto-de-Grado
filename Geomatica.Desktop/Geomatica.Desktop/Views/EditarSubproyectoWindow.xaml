<Window x:Class="Geomatica.Desktop.Views.EditarSubproyectoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Width="580" Height="640" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Encabezado -->
            <RowDefinition Height="*"/>    <!-- Contenido del formulario con scroll -->
            <RowDefinition Height="Auto"/> <!-- Pie con acciones -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             1. ENCABEZADO
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Visibility="{Binding EsNuevo, Converter={StaticResource BoolToVis}}"
                            Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1"
                            CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="Nuevo Subproyecto" FontSize="11" FontWeight="SemiBold" Foreground="#856404"/>
                    </Border>
                    <Border Visibility="{Binding EsNuevo, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Background="#EBF3EE" BorderBrush="#B2DFBF" BorderThickness="1"
                            CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IdSubproyecto, StringFormat='{}ID: #{0}'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource UisGreenBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✏️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Subtitulo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             2. CONTENIDO EDITABLE CON SCROLL
             ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <!-- Tarjeta 1: Identificación y Territorio -->
                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📌 Identificación y Territorio" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- Nombre del Subproyecto -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Nombre del Subproyecto / Frente de Trabajo *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     ToolTip="Ejemplo: Frente 01 - Tramo Norte, Estación Fluvial, Sector Central"/>
                            <TextBlock Text="{Binding NombreMensaje}"
                                       Visibility="{Binding NombreEsValido, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                       Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                        </StackPanel>

                        <!-- Municipio Asociado -->
                        <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Municipio Territorial Asociado" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Background="#F1F5F9" CornerRadius="4" Padding="6,2"
                                        ToolTip="{Binding MunicipioEstadoTexto}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MunicipioEstadoIcono}" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding MunicipioEstadoTexto}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding MunicipiosSugeridos}"
                                      Text="{Binding MunicipioTexto, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding MunicipioSeleccionado}"
                                      DisplayMemberPath="Nombre"
                                      IsEditable="True"
                                      Style="{StaticResource ModernComboBox}"
                                      ToolTip="Municipio territorial al que pertenece este subproyecto (búsqueda automática en DIVIPOLA)"/>
                            <TextBlock Text="Seleccione de los municipios del proyecto o escriba para buscar en el catálogo nacional DIVIPOLA."
                                       Style="{StaticResource HintText}" Margin="2,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Ubicación en Disco -->
                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📁 Almacenamiento en Disco" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Subcarpeta en el Proyecto *" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="📂 Examinar..."
                                    Command="{Binding SeleccionarSubcarpetaCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0" Padding="8,4" FontSize="11"
                                    ToolTip="Abrir el explorador para navegar a cualquier subcarpeta en el proyecto"/>
                            <ComboBox ItemsSource="{Binding SubcarpetasDisponibles}"
                                      Text="{Binding Subcarpeta, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Style="{StaticResource ModernComboBox}"
                                      ToolTip="Subcarpeta relativa a la raíz del proyecto donde reposan los datos (ej: Datos_Espaciales\Sector_1)"/>
                        </DockPanel>

                        <!-- Badge de estado de subcarpeta -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,4" Margin="0,2,0,0"
                                ToolTip="{Binding SubcarpetaEstadoTexto}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SubcarpetaEstadoIcono}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SubcarpetaEstadoTexto}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Coordenadas Geográficas -->
                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="🌐 Ubicación Geoespacial (WGS84)" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="📍 Copiar del Proyecto"
                                    Command="{Binding CopiarCoordenadasProyectoCommand}"
                                    IsEnabled="{Binding PuedeCopiarCoordenadas}"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                                    Padding="6,2" FontSize="11"
                                    ToolTip="Copiar coordenadas base registradas en el proyecto maestro"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Latitud (grados decimales)" Style="{StaticResource HintText}"/>
                                <TextBox Text="{Binding LatStr, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         ToolTip="Ejemplo: 7.062000"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Longitud (grados decimales)" Style="{StaticResource HintText}"/>
                                <TextBox Text="{Binding LonStr, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         ToolTip="Ejemplo: -73.854000"/>
                            </StackPanel>
                        </Grid>

                        <!-- Estado de coordenadas -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,3" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CoordenadasEstadoIcono}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CoordenadasEstadoTexto}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 4: Descripción y Observaciones -->
                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="📝 Descripción y Observaciones Técnicas (Opcional)" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                 ToolTip="Notas de campo, especificaciones del frente o particularidades técnicas"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
             3. PIE CON ACCIONES Y VALIDACIÓN
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <!-- Botones a la derecha -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancelar"
                            Command="{Binding CancelarCommand}"
                            IsCancel="True"
                            Style="{StaticResource OutlineButton}"
                            Padding="12,6" FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="💾 Guardar Cambios"
                            Command="{Binding GuardarCommand}"
                            IsEnabled="{Binding PuedeGuardar}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,6" FontSize="12"/>
                </StackPanel>

                <!-- Mensaje de error / advertencia a la izquierda -->
                <TextBlock Text="{Binding MensajeResumenError}"
                           Foreground="#DC2626" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
