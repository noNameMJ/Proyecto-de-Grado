<UserControl x:Class="Geomatica.Desktop.Views.FichaProyectoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Geomatica.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FichaProyectoViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,14,16,20" MaxWidth="600">

                <!-- ═══════════════════════════════════════════════════════════
                     BARRA SUPERIOR: Badge de Tipo + Botones de Acción
                     ═══════════════════════════════════════════════════════════ -->
                <DockPanel Margin="0,0,0,10">
                    <!-- Badge Identificador del Proyecto -->
                    <Border DockPanel.Dock="Left" Background="#E8F4EC" BorderBrush="#B2DFBF" BorderThickness="1"
                            CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="PROYECTO" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CodigoId, StringFormat='  {0}'}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1A5C34" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones de Acción: Cerrar, Editar y Eliminar -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding EditarCommand}"
                                IsEnabled="{Binding PuedeEditar}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                ToolTip="{Binding TooltipEdicion}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Editar"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EliminarCommand}"
                                IsEnabled="{Binding PuedeEliminar}"
                                Style="{StaticResource DangerButton}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                ToolTip="{Binding TooltipEliminacion}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Eliminar"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding VolverCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="8,4" FontSize="13"
                                ToolTip="Cerrar ficha">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Franja decorativa UIS (Verde institucional a Dorado) -->
                <Border Height="3" CornerRadius="1.5" Margin="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource UisGreenColor}" Offset="0.0"/>
                            <GradientStop Color="{StaticResource UisGoldColor}" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     TÍTULO DEL PROYECTO
                     ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="17"
                           LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource AppFont}"/>

                <!-- Badges rápidos de metadatos (Fecha, Municipio, Archivos) -->
                <WrapPanel Margin="0,0,0,12">
                    <!-- Chip Fecha / Periodo -->
                    <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PeriodoTexto}" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Municipio -->
                    <Border Background="#FFFDF0" BorderBrush="#EBDCA8" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6"
                            Visibility="{Binding HasMunicipio, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📍 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MunicipioNombre}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#8A6707" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Estado Archivos y Permisos UIS -->
                    <Border Background="{Binding BadgeBackgroundHex}" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6"
                            ToolTip="{Binding PermisosCarpeta.Mensaje}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EstadoRutaTexto}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding BadgeForegroundHex}" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Creador -->
                    <Border Background="#F0F4F8" BorderBrush="#D1DCE5" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6"
                            Visibility="{Binding HasCreadorInfo, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding CreadorInfo}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CreadorInfo}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#2C4C64" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Última Modificación -->
                    <Border Background="#FBF7EE" BorderBrush="#E9DEBE" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6"
                            Visibility="{Binding HasUltimaModificacionInfo, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding UltimaModificacionInfo}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UltimaModificacionInfo}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#785B12" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     SECCIÓN: DESCRIPCIÓN
                     ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="DESCRIPCIÓN" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,5"
                           FontFamily="{StaticResource AppFontSemibold}"/>
                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Descripcion, TargetNullValue='Sin descripción registrada para este proyecto.'}"
                               TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFont}"/>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     SECCIÓN: ACTORES Y GOBERNANZA
                     ═══════════════════════════════════════════════════════════ -->
                <StackPanel Visibility="{Binding HasActores, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="ACTORES Y GOBERNANZA" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,5"
                               FontFamily="{StaticResource AppFontSemibold}"/>
                    <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" Padding="12,10">
                        <StackPanel>
                            <!-- Representante -->
                            <DockPanel Margin="0,0,0,6" Visibility="{Binding HasRepresentante, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="👤 Representante:" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                           Width="110" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Representante}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Entidades -->
                            <DockPanel Visibility="{Binding HasEntidades, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🏛️ Entidades:" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                           Width="110" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Entidades}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     SECCIÓN: PALABRAS CLAVE / ETIQUETAS
                     ═══════════════════════════════════════════════════════════ -->
                <StackPanel Visibility="{Binding HasPalabrasClave, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="PALABRAS CLAVE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"
                               FontFamily="{StaticResource AppFontSemibold}"/>
                    <ItemsControl ItemsSource="{Binding PalabrasClaveLista}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EDF6F0" BorderBrush="#BFE0C8" BorderThickness="1"
                                        CornerRadius="10" Padding="8,3" Margin="0,0,5,5">
                                    <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource UisGreenBrush}" FontFamily="{StaticResource AppFont}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     SECCIÓN: UBICACIÓN Y COORDENADAS
                     ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="UBICACIÓN GEOGRÁFICA" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,5"
                           FontFamily="{StaticResource AppFontSemibold}"/>
                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Municipio y Código (si existe) -->
                        <DockPanel Margin="0,0,0,8" Visibility="{Binding HasMunicipio, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Municipio:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MunicipioNombre}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MunicipioCodigo, StringFormat='(Cód. {0})'}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Métricas de Latitud y Longitud -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="LATITUD" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="{Binding LatitudTexto}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LONGITUD" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="{Binding LongitudTexto}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Botón Copiar Coordenadas -->
                        <Button Command="{Binding CopiarCoordenadasCommand}"
                                Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch"
                                Padding="10,5" FontSize="11.5" ToolTip="Copiar latitud y longitud al portapapeles">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Copiar coordenadas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     SECCIÓN: REPOSITORIO DE ARCHIVOS
                     ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="REPOSITORIO DE ARCHIVOS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,5"
                           FontFamily="{StaticResource AppFontSemibold}"/>
                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Cuadro de texto con la ruta -->
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <TextBlock Text="{Binding RutaArchivos, TargetNullValue='Sin ruta de archivos asignada'}"
                                       FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Resumen de Formatos Detectados Automáticamente -->
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                Visibility="{Binding HasRutaArchivos, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Formatos e insumos espaciales:" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"/>
                                    <TextBlock Text="{Binding TotalArchivosDetectados, StringFormat='({0} archivos)'}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                               HorizontalAlignment="Right"/>
                                </DockPanel>

                                <!-- Indicador de escaneo en segundo plano -->
                                <TextBlock Text="Analizando tipos de archivos en la carpeta..." FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,2,0,2"
                                           Visibility="{Binding CargandoFormatos, Converter={StaticResource BoolToVis}}"/>

                                <!-- Badges de Extensiones Reales detectadas (Interactivas para filtrar) -->
                                <ItemsControl ItemsSource="{Binding ExtensionesDetectadas}"
                                              Visibility="{Binding HasExtensionesDetectadas, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.FiltrarPorExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Extension}"
                                                    Cursor="Hand" Margin="0,0,5,4" Padding="0"
                                                    Background="Transparent" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding BadgeBgHex}" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1"
                                                                CornerRadius="10" Padding="7,3" ToolTip="{Binding TooltipTexto}">
                                                            <TextBlock Text="{Binding TextoBadge}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding BadgeFgHex}" FontFamily="{StaticResource AppFont}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="💡 Clic en una extensión para listar y ubicar sus archivos"
                                           FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,2,0,0"
                                           Visibility="{Binding HasExtensionesDetectadas, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Botones de Acción de Archivos -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding AbrirCarpetaCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                    Padding="8,6" FontSize="12" Margin="0,0,6,0"
                                    IsEnabled="{Binding PuedeLeerArchivos}"
                                    ToolTip="{Binding TooltipAbrirCarpeta}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Abrir carpeta" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Command="{Binding DescargarZipCommand}"
                                    Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch"
                                    Padding="8,6" FontSize="12" Margin="0,0,6,0"
                                    IsEnabled="{Binding PuedeDescargarZip}"
                                    ToolTip="{Binding TooltipDescargarZip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📦 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Descargar ZIP" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding CopiarRutaCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="10,6" FontSize="12"
                                    ToolTip="Copiar ruta de carpeta al portapapeles">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Indicador y Barra de Progreso de Empaquetado ZIP -->
                        <Border Margin="0,6,0,0" Padding="8,6" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding IsDescargandoZip, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding EstadoDescargaZipTexto, FallbackValue='Empaquetando archivos en ZIP...'}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProgresoDescargaZip, StringFormat='{}{0:F0}%'}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar Value="{Binding ProgresoDescargaZip}" Maximum="100" Height="6" 
                                             Foreground="{StaticResource UisGreenBrush}" Background="#DCFCE7" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     SECCIÓN: HISTORIAL DE CAMBIOS Y AUDITORÍA
                     ═══════════════════════════════════════════════════════════ -->
                <DockPanel Margin="0,4,0,5">
                    <TextBlock Text="HISTORIAL DE ACTIVIDAD Y CAMBIOS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFontSemibold}"/>
                    <Button Command="{Binding ToggleHistorialCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="8,2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Mostrar u ocultar la lista de cambios de este proyecto">
                        <TextBlock Text="{Binding TextoBotonHistorial}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource UisGreenBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                    </Button>
                </DockPanel>

                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="12,10" Margin="0,0,0,12"
                        Visibility="{Binding MostrarHistorial, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Estado de carga -->
                        <TextBlock Text="Cargando historial de cambios..."
                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                   FontStyle="Italic" Margin="2"
                                   Visibility="{Binding CargandoHistorial, Converter={StaticResource BoolToVis}}"/>

                        <!-- Mensaje cuando no hay registros -->
                        <TextBlock Text="No se encontraron registros de auditoría para este proyecto."
                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                   FontStyle="Italic" Margin="2"
                                   Visibility="{Binding HasNoHistorial, Converter={StaticResource BoolToVis}}"/>

                        <!-- Lista de eventos de auditoría -->
                        <ItemsControl ItemsSource="{Binding HistorialAuditoria}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFBFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Fila Superior: Badge Acción + Fecha/Hora -->
                                            <DockPanel Grid.Row="0">
                                                <!-- Badge Acción -->
                                                <Border DockPanel.Dock="Left" Background="{Binding AccionBadgeBg}"
                                                        BorderBrush="{Binding AccionBadgeBorder}" BorderThickness="1"
                                                        CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AccionIcono}" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBlock Text="{Binding Accion}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{Binding AccionBadgeColor}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Fecha y Hora -->
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FechaHoraTexto}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <!-- Fila Inferior: Usuario, Equipo y Detalles -->
                                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Usuario}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Equipo, StringFormat='  (💻 {0})'}" FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detalles}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontFamily="{StaticResource AppFont}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     BANNER INFORMATIVO INFERIOR
                     ═══════════════════════════════════════════════════════════ -->
                <Border Background="#F2FAF5" BorderBrush="#BEE5CF" BorderThickness="1"
                        CornerRadius="6" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="Los archivos y capas del proyecto se encuentran listados en el panel inferior."
                                   FontSize="11" Foreground="#1E6539" FontFamily="{StaticResource AppFont}"
                                   TextWrapping="Wrap" LineHeight="15" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
