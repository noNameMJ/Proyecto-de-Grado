<UserControl x:Class="Geomatica.Desktop.Views.FichaProyectoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Geomatica.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FichaProyectoViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilo interactivo para encabezados de sección plegables / expandibles -->
        <Style x:Key="SeccionHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HdrBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HdrBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="HdrBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HdrBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,14,16,20" HorizontalAlignment="Stretch" MaxWidth="780">

                <!-- ═══════════════════════════════════════════════════════════
                     BARRA SUPERIOR: Badge de Metadato ISO 19115 + Botones de Acción
                     ═══════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Badge Identificador del Metadato (ISO 19115 fileIdentifier) -->
                    <Border Grid.Column="0" Background="#E8F4EC" BorderBrush="#B2DFBF" BorderThickness="1"
                            CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="METADATOS ISO 19115" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CodigoId, StringFormat='  {0}'}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1A5C34" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones de Acción: Editar, Eliminar y Cerrar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding EditarCommand}"
                                IsEnabled="{Binding PuedeEditar}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                ToolTip="{Binding TooltipEdicion}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Editar"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EliminarCommand}"
                                IsEnabled="{Binding PuedeEliminar}"
                                Style="{StaticResource DangerButton}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                ToolTip="{Binding TooltipEliminacion}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Eliminar"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding VolverCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="8,4" FontSize="13"
                                ToolTip="Cerrar ficha">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Franja decorativa UIS (Verde institucional a Dorado) -->
                <Border Height="3" CornerRadius="1.5" Margin="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource UisGreenColor}" Offset="0.0"/>
                            <GradientStop Color="{StaticResource UisGoldColor}" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     TÍTULO OFICIAL DEL RECURSO (citation.title)
                     ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="17"
                           LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource AppFont}"/>

                <!-- Badges rápidos de metadatos (Fecha, Municipio, Permisos, Creador, Modificación) -->
                <WrapPanel Margin="0,0,0,14">
                    <!-- Chip Fecha / Periodo Temporal -->
                    <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PeriodoTexto}" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Municipio (Territorio) -->
                    <Border Background="#FFFDF0" BorderBrush="#EBDCA8" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6" MaxWidth="480"
                            ToolTip="{Binding MunicipioChipTooltip}"
                            Visibility="{Binding HasMunicipio, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📍 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MunicipioChipTexto}" FontSize="11" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="440"
                                       Foreground="#8A6707" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Estado Archivos y Permisos UIS -->
                    <Border Background="{Binding BadgeBackgroundHex}" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6"
                            ToolTip="{Binding PermisosCarpeta.Mensaje}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EstadoRutaTexto}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding BadgeForegroundHex}" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Creador -->
                    <Border Background="#F0F4F8" BorderBrush="#D1DCE5" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6"
                            Visibility="{Binding HasCreadorInfo, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding CreadorInfo}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CreadorInfo}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#2C4C64" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip Última Modificación -->
                    <Border Background="#FBF7EE" BorderBrush="#E9DEBE" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,6,6"
                            Visibility="{Binding HasUltimaModificacionInfo, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding UltimaModificacionInfo}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒 " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UltimaModificacionInfo}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#785B12" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     BARRA DE CONTROL: SECCIONES DE METADATOS (Expandir / Contraer)
                     ═══════════════════════════════════════════════════════════ -->
                <DockPanel Margin="0,4,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="ESTRUCTURA DE METADATOS (ISO 19115)" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                        <TextBlock Text="{Binding ResumenSeccionesExpandidasTexto}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding ExpandirTodasSeccionesCommand}"
                                Style="{StaticResource GhostButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                ToolTip="Expandir todas las secciones de metadatos">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▼ " FontSize="9" VerticalAlignment="Center"/>
                                <TextBlock Text="Expandir todas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ContraerTodasSeccionesCommand}"
                                Style="{StaticResource GhostButton}" Padding="6,2" FontSize="11"
                                ToolTip="Contraer todas las secciones de metadatos">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▲ " FontSize="9" VerticalAlignment="Center"/>
                                <TextBlock Text="Contraer todas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                     1. IDENTIFICACIÓN Y DESCRIPCIÓN (MD_DataIdentification)
                     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
                <Button Command="{Binding ToggleSeccion1Command}" Style="{StaticResource SeccionHeaderButtonStyle}"
                        ToolTip="Clic para expandir o contraer esta sección">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChevronSeccion1}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="📋 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="1. IDENTIFICACIÓN Y DESCRIPCIÓN" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="MD_DataIdentification" FontSize="9" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </DockPanel>
                </Button>

                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,14"
                        Visibility="{Binding Seccion1Expandida, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Resumen / Abstract -->
                        <TextBlock Text="RESUMEN DESCRIPTIVO (ABSTRACT)" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Descripcion, TargetNullValue='Sin descripción registrada para este recurso.'}"
                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                   Margin="0,0,0,10"/>

                        <!-- Responsables y Gobernanza (CI_ResponsibleParty) -->
                        <StackPanel Visibility="{Binding HasActores, Converter={StaticResource BoolToVis}}" Margin="0,4,0,10">
                            <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,0,8"/>
                            <TextBlock Text="PUNTOS DE CONTACTO Y CUSTODIA (CI_ResponsibleParty)" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}" Margin="0,0,0,6"/>

                            <DockPanel Margin="0,0,0,4" Visibility="{Binding HasRepresentante, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="👤 Responsable / Líder:" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                           Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Representante}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel Visibility="{Binding HasEntidades, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🏛️ Entidades Vinculadas:" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                           Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Entidades}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Palabras Clave / Temas (MD_Keywords) -->
                        <StackPanel Visibility="{Binding HasPalabrasClave, Converter={StaticResource BoolToVis}}">
                            <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,0,8"/>
                            <TextBlock Text="PALABRAS CLAVE Y CATEGORÍAS (MD_Keywords)" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding PalabrasClaveLista}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#EDF6F0" BorderBrush="#BFE0C8" BorderThickness="1"
                                                CornerRadius="10" Padding="8,3" Margin="0,0,5,5">
                                            <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource UisGreenBrush}" FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                     2. EXTENSIÓN Y LOCALIZACIÓN GEOGRÁFICA (EX_Extent)
                     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
                <Button Command="{Binding ToggleSeccion2Command}" Style="{StaticResource SeccionHeaderButtonStyle}"
                        ToolTip="Clic para expandir o contraer esta sección">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChevronSeccion2}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="📍 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="2. EXTENSIÓN Y LOCALIZACIÓN GEOGRÁFICA" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="EX_Extent" FontSize="9" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </DockPanel>
                </Button>

                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,14"
                        Visibility="{Binding Seccion2Expandida, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Jurisdicción Político-Administrativa (Hasta 3 municipios) -->
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding HasPocosMunicipios, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Municipio(s) / Territorio(s):" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource AppFont}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding MunicipioNombre}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MunicipioCodigo, StringFormat='DIVIPOLA: {0}'}"
                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Cobertura Territorial Multi-municipal (> 3 municipios) -->
                        <Border Margin="0,0,0,10" Background="#FAFBFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Padding="10,10"
                                Visibility="{Binding EsPlurimunicipal, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Encabezado y Métricas -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏛️ " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="COBERTURA MULTI-MUNICIPAL" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="#1E293B" FontFamily="{StaticResource AppFontSemibold}"/>
                                        </StackPanel>
                                        <!-- Métricas -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#E8F4EC" BorderBrush="#B2DFBF" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TotalMunicipios, StringFormat='{}{0} MUNICIPIOS'}"
                                                           FontSize="10" FontWeight="Bold" Foreground="{StaticResource UisGreenBrush}"/>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding TotalDepartamentos, StringFormat='{}{0} DEPARTAMENTOS'}"
                                                           FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Botón Copiar Listado -->
                                    <Button Grid.Column="1" Command="{Binding CopiarMunicipiosCommand}"
                                            Style="{StaticResource ToolbarButton}" Padding="8,4" FontSize="11"
                                            VerticalAlignment="Center"
                                            ToolTip="Copiar listado con códigos DIVIPOLA al portapapeles">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 " FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copiar listado" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Barra de búsqueda y filtro por departamento -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Input de búsqueda por texto -->
                                    <Grid Grid.Column="0" Margin="0,0,6,0">
                                        <TextBox Text="{Binding FiltroMunicipioTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Padding="8,5,24,5" FontSize="11.5"
                                                 ToolTip="Buscar municipio por nombre, departamento o código DIVIPOLA"/>
                                        <TextBlock Text="🔍 Buscar municipio..." IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasNoFiltroMunicipioTexto, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Botón limpiar búsqueda -->
                                        <Button Command="{Binding LimpiarFiltrosMunicipioCommand}"
                                                Style="{StaticResource ClearButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                Visibility="{Binding HasFiltroMunicipioTexto, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Limpiar búsqueda">
                                            <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Combo de filtrado por departamento (si hay más de 1 dpto) -->
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DepartamentosFiltro}"
                                              SelectedItem="{Binding FiltroDepartamentoSeleccionado, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayTexto"
                                              Style="{StaticResource ModernComboBox}"
                                              Padding="6,4" FontSize="11" Width="170"
                                              Visibility="{Binding HasMultiplesDepartamentos, Converter={StaticResource BoolToVis}}"
                                              ToolTip="Filtrar por departamento"/>
                                </Grid>

                                <!-- Listado con scroll controlado (MaxHeight=200) -->
                                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,0,0,6">
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <!-- Estado vacío si el filtro no arrojó resultados -->
                                            <Border Padding="16,20" Visibility="{Binding HasNoMunicipiosFiltrados, Converter={StaticResource BoolToVis}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <TextBlock Text="No se encontraron municipios con ese criterio"
                                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" FontFamily="{StaticResource AppFont}"/>
                                                    <Button Command="{Binding LimpiarFiltrosMunicipioCommand}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                            Content="Restablecer filtros" FontSize="11"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Items de Municipios -->
                                            <ItemsControl ItemsSource="{Binding MunicipiosFiltrados}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="8,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="📍 " FontSize="9" VerticalAlignment="Center" Foreground="#64748B"/>
                                                                    <TextBlock Text="{Binding Nombre}" FontSize="11.5" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DepartamentoEtiqueta}"
                                                                               FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                                               FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"
                                                                               Visibility="{Binding HasDepartamento, Converter={StaticResource BoolToVis}}"
                                                                               Margin="2,0,0,0"/>
                                                                </StackPanel>

                                                                <!-- Badge DIVIPOLA -->
                                                                <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1"
                                                                        BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasCodigo, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding Codigo}" FontSize="9.5" FontWeight="SemiBold"
                                                                               Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- Pie de estado del listado -->
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TextoConteoMunicipiosFiltrados}"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                               VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Command="{Binding LimpiarFiltrosMunicipioCommand}"
                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="4,1"
                                            Visibility="{Binding TieneFiltroActivo, Converter={StaticResource BoolToVis}}"
                                            Content="Mostrar todos" FontSize="10"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Métricas de Latitud y Longitud WGS84 -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="LATITUD (WGS 84)" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="{Binding LatitudTexto}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LONGITUD (WGS 84)" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="{Binding LongitudTexto}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Botón Copiar Coordenadas -->
                        <Button Command="{Binding CopiarCoordenadasCommand}"
                                Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch"
                                Padding="10,5" FontSize="11.5" ToolTip="Copiar latitud y longitud al portapapeles">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Copiar coordenadas geográficas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>


                    </StackPanel>
                </Border>

                <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                     3. SISTEMA DE REFERENCIA ESPACIAL (MD_ReferenceSystem)
                     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
                <Button Command="{Binding ToggleSeccion3Command}" Style="{StaticResource SeccionHeaderButtonStyle}"
                        ToolTip="Clic para expandir o contraer esta sección">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChevronSeccion3}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="🧭 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="3. SISTEMA DE REFERENCIA ESPACIAL" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="MD_ReferenceSystem" FontSize="9" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </DockPanel>
                </Button>

                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,14"
                        Visibility="{Binding Seccion3Expandida, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- SRID y Formato Principal en métricas -->
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="SISTEMA DE REFERENCIA (SRID / EPSG)" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="{Binding SistemaReferencia, TargetNullValue='No especificado'}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="REPRESENTACIÓN ESPACIAL / FORMATO" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    <!-- Badges estructurados si existen tipos de datos espaciales -->
                                    <ItemsControl ItemsSource="{Binding TiposDatosEspaciales}" Margin="0,4,0,0"
                                                  Visibility="{Binding HasTiposDatosEspaciales, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BadgeBgHex}" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1"
                                                        CornerRadius="6" Padding="6,2" Margin="0,0,4,4"
                                                        ToolTip="{Binding TooltipTexto}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icono}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Categoria}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{Binding BadgeFgHex}" FontFamily="{StaticResource AppFontSemibold}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ConteoTexto, StringFormat=' ({0})'}" FontSize="9.5"
                                                                   Foreground="{Binding BadgeFgHex}" FontFamily="{StaticResource AppFont}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Fallback cuando no hay datos espaciales estructurados -->
                                    <TextBlock Text="{Binding FormatoDatos, TargetNullValue='No especificado'}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasNoTiposDatosEspaciales, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Estado cuando aún no se ha auto-detectado o registrado SRID -->
                        <TextBlock Text="💡 Puede extraer el sistema de referencia automáticamente desde los archivos editando el proyecto."
                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0"
                                   Visibility="{Binding HasNoIsoMetadata, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                     4. CALIDAD Y LINAJE DE LOS DATOS (LI_Lineage)
                     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
                <Button Command="{Binding ToggleSeccion4Command}" Style="{StaticResource SeccionHeaderButtonStyle}"
                        ToolTip="Clic para expandir o contraer esta sección">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChevronSeccion4}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="🛡️ " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="4. CALIDAD Y LINAJE DE LOS DATOS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ResumenTiposDatosTexto}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="LI_Lineage" FontSize="9" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </DockPanel>
                </Button>

                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,14"
                        Visibility="{Binding Seccion4Expandida, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Banner Superior de Trazabilidad ISO 19115 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ " FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="Trazabilidad y Linaje Técnico del Dato" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="#1E293B" FontFamily="{StaticResource AppFontSemibold}"/>
                                    </StackPanel>
                                    <TextBlock Text="Registro estructurado de fuentes, representaciones espaciales y procedencia conforme al estándar geográfico internacional."
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource AppFont}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                        CornerRadius="12" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🏅 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding NormaIsoTexto, FallbackValue='ISO 19115-1:2014'}" FontSize="10" FontWeight="Bold"
                                                   Foreground="#065F46" FontFamily="Consolas, Segoe UI"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Subsección: Tipos de Datos y Formatos Espaciales Encontrados -->
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="TIPOS DE DATOS Y FORMATOS ESPACIALES IDENTIFICADOS" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                <TextBlock Text="{Binding TotalFuentesEspacialesTexto, StringFormat=' ({0})'}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource UisGreenBrush}" FontFamily="{StaticResource AppFontSemibold}"
                                           Visibility="{Binding HasTotalFuentesEspaciales, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Grid de Tarjetas Interactivas de Tipos de Datos -->
                        <ItemsControl ItemsSource="{Binding TiposDatosEspaciales}" Margin="0,0,0,8"
                                      Visibility="{Binding HasTiposDatosEspaciales, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BadgeBgHex}" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,6" Margin="0,0,6,6" MinWidth="130"
                                            ToolTip="{Binding TooltipTexto}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icono}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Categoria}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding BadgeFgHex}" FontFamily="{StaticResource AppFontSemibold}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Background="White" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="0.8"
                                                    CornerRadius="4" Padding="5,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ConteoTexto}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{Binding BadgeFgHex}" FontFamily="{StaticResource AppFont}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Detalle}" FontSize="9" Foreground="{Binding BadgeFgHex}"
                                                       Opacity="0.85" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Estado cuando no hay tipos de datos espaciales detectados aún -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding HasNoTiposDatosEspaciales, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️ " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Sin tipos de datos espaciales discriminados en los metadatos."
                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Subsección: Fuentes y Carpetas Exploradas (si existen) -->
                        <StackPanel Visibility="{Binding HasSubcarpetasLinaje, Converter={StaticResource BoolToVis}}" Margin="0,2,0,10">
                            <TextBlock Text="DIRECTORIOS Y SUBFUENTES DE PROCEDENCIA" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding SubcarpetasLinaje}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                                CornerRadius="10" Padding="8,3" Margin="0,0,5,5"
                                                ToolTip="Subdirectorio explorado que aportó insumos espaciales al proyecto">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁 " FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" FontSize="10" FontFamily="Consolas, Segoe UI"
                                                           Foreground="#334155" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Chip de Insumo de Georreferenciación (si existe) -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                                Padding="8,6" Margin="0,0,0,10"
                                Visibility="{Binding HasInsumoReferenciaLinaje, Converter={StaticResource BoolToVis}}"
                                ToolTip="Archivo espacial a partir del cual se extrajo y validó la proyección SRID oficial">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Insumo geodésico de referencia: " FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#1E40AF" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InsumoReferenciaLinaje}" FontSize="10.5" FontFamily="Consolas, Segoe UI"
                                           Foreground="#1D4ED8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Subsección: Declaración Narrativa de Linaje (Lineage Statement) -->
                        <DockPanel Margin="0,2,0,4">
                            <TextBlock Text="DECLARACIÓN DE LINAJE Y PROCEDENCIA (LINEAGE STATEMENT)" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFontSemibold}"
                                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Command="{Binding CopiarLinajeCommand}" Style="{StaticResource GhostButton}"
                                    Padding="6,2" FontSize="10.5" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                    ToolTip="Copiar declaración completa de linaje al portapapeles"
                                    Visibility="{Binding HasLinaje, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 " FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiar texto" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="3,1,1,1"
                                CornerRadius="4" Padding="12,10" Margin="0,0,0,0">
                            <TextBlock Text="{Binding Linaje, TargetNullValue='Sin historial de linaje registrado. Utilice la función de auto-detección al editar el proyecto para documentar fuentes e insumos automáticamente conforme a ISO 19115.'}"
                                       FontSize="11.5" LineHeight="18"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                     5. DISTRIBUCIÓN Y RECURSOS DIGITALES (MD_Distribution)
                     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
                <Button Command="{Binding ToggleSeccion5Command}" Style="{StaticResource SeccionHeaderButtonStyle}"
                        ToolTip="Clic para expandir o contraer esta sección">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChevronSeccion5}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="📦 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="5. DISTRIBUCIÓN Y RECURSOS DIGITALES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalArchivosDetectadosTexto}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="MD_Distribution" FontSize="9" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </DockPanel>
                </Button>

                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,14"
                        Visibility="{Binding Seccion5Expandida, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- ─── Enlace y Ruta de Almacenamiento (onLine.linkage) ─── -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="📂 " FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="REPOSITORIO FÍSICO Y DISTRIBUCIÓN (onLine.linkage)" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{Binding PermisosCarpeta.BadgeBackgroundHex, FallbackValue='#F1F5F9'}"
                                            BorderBrush="{Binding PermisosCarpeta.BadgeBorderHex, FallbackValue='#CBD5E1'}" BorderThickness="1"
                                            CornerRadius="8" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding HasRutaArchivos, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PermisosCarpeta.BadgeTexto, FallbackValue='Lectura'}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{Binding PermisosCarpeta.BadgeForegroundHex, FallbackValue='#475569'}"/>
                                    </Border>
                                </DockPanel>

                                <!-- Ruta Monospace -->
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding RutaArchivos, TargetNullValue='Sin ruta de archivos asignada'}"
                                               FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <!-- Botones de Acción de Archivos y Transferencia Digital -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Command="{Binding AbrirCarpetaCommand}"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                            Padding="10,6" FontSize="11.5" Margin="0,0,6,0"
                                            IsEnabled="{Binding PuedeLeerArchivos}"
                                            ToolTip="{Binding TooltipAbrirCarpeta}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Abrir carpeta" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Command="{Binding DescargarZipCommand}"
                                            Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch"
                                            Padding="10,6" FontSize="11.5" Margin="0,0,6,0"
                                            IsEnabled="{Binding PuedeDescargarZip}"
                                            ToolTip="{Binding TooltipDescargarZip}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📦 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Descargar ZIP" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Command="{Binding CopiarRutaCommand}"
                                            Style="{StaticResource OutlineButton}" Padding="12,6" FontSize="11.5"
                                            ToolTip="Copiar ruta de carpeta al portapapeles">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copiar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Indicador y Barra de Progreso de Empaquetado ZIP -->
                                <Border Margin="0,8,0,0" Padding="8,6" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4"
                                        Visibility="{Binding IsDescargandoZip, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding EstadoDescargaZipTexto, FallbackValue='Empaquetando archivos en ZIP...'}" 
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ProgresoDescargaZip, StringFormat='{}{0:F0}%'}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding ProgresoDescargaZip}" Maximum="100" Height="6" 
                                                     Foreground="{StaticResource UisGreenBrush}" Background="#DCFCE7" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ─── Tarjetas KPI de Resumen de Inventario Digital ─── -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding HasRutaArchivos, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KPI 1: Total Archivos -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="📄" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="TOTAL ARCHIVOS" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalArchivosDetectados, StringFormat='{}{0:N0}'}"
                                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="Archivos indexados" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 2: Volumen de Datos -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="VOLUMEN EN DISCO" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TamanoTotalDetectadoTexto, FallbackValue='0 B'}"
                                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource UisGreenBrush}"
                                               FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="Tamaño detectado" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 3: Categorías GIS -->
                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="🗺️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FAMILIAS DE DATOS" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalCategoriasDetectadas, StringFormat='{}{0}'}"
                                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource ChromeDarkBrush}"
                                               FontFamily="{StaticResource AppFontSemibold}"/>
                                    <TextBlock Text="Familias GIS" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ─── Barra de Filtrado y Búsqueda Interactiva ─── -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding HasFormatosDetectados, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="FORMATOS Y FAMILIAS DE DATOS" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                                    </StackPanel>

                                    <!-- Campo de Búsqueda Rápida de Extensión / Categoría -->
                                    <Grid DockPanel.Dock="Right" HorizontalAlignment="Right" Width="190">
                                        <TextBox Text="{Binding BusquedaFormatoTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Padding="8,4,22,4" FontSize="11"
                                                 ToolTip="Buscar por extensión (.shp, .tif, .pdf...) o por nombre de categoría"/>
                                        <TextBlock Text="🔍 Buscar formato..." IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasNoBusquedaFormatoTexto, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Botón limpiar búsqueda -->
                                        <Button Command="{Binding LimpiarBusquedaFormatoCommand}"
                                                Style="{StaticResource ClearButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                Visibility="{Binding HasBusquedaFormatoTexto, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Limpiar búsqueda">
                                            <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </DockPanel>

                                <!-- Pestañas Segmentadas por Categoría -->
                                <ItemsControl ItemsSource="{Binding CategoriasTabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SeleccionarTabCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Nombre}"
                                                    Cursor="Hand" Margin="0,0,6,5" Padding="0"
                                                    Background="Transparent" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="TabBorder" CornerRadius="12" Padding="8,4"
                                                                BorderThickness="1" SnapsToDevicePixels="True">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icono}" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TabTitle" Text="{Binding Nombre}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <Border x:Name="CountBadge" CornerRadius="8" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="CountText" Text="{Binding CantidadArchivos}" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#E2E8F0"/>
                                                                <Setter TargetName="TabTitle" Property="Foreground" Value="#475569"/>
                                                                <Setter TargetName="CountBadge" Property="Background" Value="#F1F5F9"/>
                                                                <Setter TargetName="CountText" Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="TabBorder" Property="Background" Value="#E8F4EC"/>
                                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource UisGreenBrush}"/>
                                                                <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource UisGreenBrush}"/>
                                                                <Setter TargetName="CountBadge" Property="Background" Value="{StaticResource UisGreenBrush}"/>
                                                                <Setter TargetName="CountText" Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource UisGreenBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Indicador de escaneo en segundo plano -->
                        <TextBlock Text="{Binding TextoProgresoFormatos}" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,2,0,8"
                                   Visibility="{Binding CargandoFormatos, Converter={StaticResource BoolToVis}}"/>

                        <!-- ─── Grupos de Formatos Clasificados por Categoría ─── -->
                        <ItemsControl ItemsSource="{Binding GruposFormatosFiltrados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,0,10" SnapsToDevicePixels="True">
                                        <StackPanel>
                                            <!-- Cabecera de la Categoría -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                                    CornerRadius="7,7,0,0" Padding="12,8">
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <Border Background="{Binding BadgeBgHex}" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1"
                                                                CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Icono}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Categoria}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding BadgeFgHex}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding CantidadArchivos, StringFormat='{}{0:N0} archivos'}"
                                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text=" • " FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TamanoTexto}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Botón Explorar Categoría en Pestaña Archivos -->
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.ExplorarCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Categoria}"
                                                            Cursor="Hand" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                                            Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            ToolTip="Filtrar y listar todos los archivos de esta categoría en el explorador">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnBrd" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="🔍 " FontSize="9" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Explorar categoría" FontSize="9.5" FontWeight="SemiBold"
                                                                                   Foreground="#334155" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnBrd" Property="Background" Value="#E2E8F0"/>
                                                                        <Setter TargetName="btnBrd" Property="BorderBrush" Value="#94A3B8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DockPanel>
                                            </Border>

                                            <!-- Cuerpo: Formatos Principales + Formatos Auxiliares -->
                                            <StackPanel Margin="12,10">
                                                <!-- Formatos Principales / Primarios -->
                                                <ItemsControl ItemsSource="{Binding ExtensionesPrincipales}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.FiltrarPorExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Extension}"
                                                                    Cursor="Hand" Margin="0,0,8,8" Padding="0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    ToolTip="{Binding TooltipTexto}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="chipBorder" Background="{Binding BadgeBgHex}" BorderBrush="{Binding BadgeBorderHex}"
                                                                                BorderThickness="1" CornerRadius="6" Padding="10,6" SnapsToDevicePixels="True">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Icono}" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="." FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeFgHex}"/>
                                                                                        <TextBlock Text="{Binding ExtensionMayus}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeFgHex}"/>
                                                                                        <Border Background="#FFFFFF" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1"
                                                                                                CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding CantidadArchivos}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding BadgeFgHex}"/>
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding TamanoTexto}" FontSize="9" Foreground="#64748B" Margin="0,1,0,0"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource UisGreenBrush}"/>
                                                                                <Setter TargetName="chipBorder" Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Sección Desplegable para Archivos Auxiliares y Sidecars (.dbf, .shx, .prj, etc.) -->
                                                <StackPanel Margin="0,4,0,0" Visibility="{Binding TieneExtensionesAuxiliares, Converter={StaticResource BoolToVis}}">
                                                    <Button Command="{Binding ToggleAuxiliaresCommand}" Cursor="Hand" Background="Transparent"
                                                            BorderThickness="0" Padding="0,3" HorizontalAlignment="Left"
                                                            ToolTip="Mostrar u ocultar archivos complementarios requeridos por el formato GIS">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding TextoToggleAuxiliares}" FontSize="9.5" FontWeight="SemiBold"
                                                                                   Foreground="#475569" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- Sub-panel de Auxiliares desplegado -->
                                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                                            Padding="8,6" Margin="0,6,0,0"
                                                            Visibility="{Binding MostrarAuxiliares, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock Text="Archivos auxiliares requeridos para metadatos, índices o atributos (sidecars):"
                                                                       FontSize="9" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,4"/>
                                                            <ItemsControl ItemsSource="{Binding ExtensionesAuxiliares}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.FiltrarPorExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Extension}"
                                                                                Cursor="Hand" Margin="0,0,5,4" Padding="0"
                                                                                Background="Transparent" BorderThickness="0"
                                                                                ToolTip="{Binding TooltipTexto}">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="auxBrd" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                                                                            CornerRadius="4" Padding="7,3">
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <TextBlock Text="." FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                                                            <TextBlock Text="{Binding ExtensionMayus}" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                                                            <TextBlock Text="{Binding CantidadArchivos, StringFormat=' ({0})'}" FontSize="9" Foreground="#64748B"/>
                                                                                            <TextBlock Text="{Binding TamanoTexto, StringFormat=' · {0}'}" FontSize="8.5" Foreground="#94A3B8"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="auxBrd" Property="BorderBrush" Value="{StaticResource UisGreenBrush}"/>
                                                                                            <Setter TargetName="auxBrd" Property="Background" Value="#F0FDF4"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mensaje cuando la búsqueda no produce resultados -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                Padding="14,12" Margin="0,4,0,0"
                                Visibility="{Binding ShowNoGruposFormatos, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍 No se encontraron formatos que coincidan con la búsqueda."
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <Button Command="{Binding LimpiarBusquedaFormatoCommand}"
                                        Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="10.5"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="Restablecer filtros y ver todos"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Mensaje cuando no hay archivos detectados en la carpeta -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                Padding="14,12" Margin="0,4,0,0"
                                Visibility="{Binding HasNoFormatosDetectados, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📂 No se detectaron archivos en el repositorio configurado."
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Verifique la ruta o agregue datos espaciales a la carpeta del proyecto."
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="💡 Clic en cualquier formato o categoría para listar y ubicar sus archivos directamente en el explorador"
                                   FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,8,0,0"
                                   Visibility="{Binding HasFormatosDetectados, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                     6. INFORMACIÓN DEL METADATO Y AUDITORÍA (MD_Metadata)
                     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
                <Button Command="{Binding ToggleSeccion6Command}" Style="{StaticResource SeccionHeaderButtonStyle}"
                        ToolTip="Clic para expandir o contraer esta sección">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChevronSeccion6}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="🕒 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="6. INFORMACIÓN DEL METADATO Y AUDITORÍA" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="MD_Metadata" FontSize="9" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </DockPanel>
                </Button>

                <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,14"
                        Visibility="{Binding Seccion6Expandida, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Fecha del Metadato (dateStamp) -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Fecha de registro / última actualización:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FechaActualizacionTexto}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Button Command="{Binding ToggleHistorialCommand}"
                                    Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                    Padding="8,2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="Mostrar u ocultar la trazabilidad completa del registro">
                                <TextBlock Text="{Binding TextoBotonHistorial}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource UisGreenBrush}" FontFamily="{StaticResource AppFontSemibold}"/>
                            </Button>
                        </DockPanel>

                        <!-- Panel Desplegable de Auditoría -->
                        <Border Background="#FAFBFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                                Visibility="{Binding MostrarHistorial, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Selector de Subpestaña: Metadatos vs Archivos -->
                                <Border Background="#EEF2F6" CornerRadius="6" Padding="3" Margin="0,0,0,10" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Botón Metadatos del Proyecto -->
                                        <Button Command="{Binding SeleccionarAuditoriaProyectoCommand}"
                                                Padding="10,4" Margin="0,0,2,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsAuditoriaProyectoSeleccionada}" Value="True">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏛️ " FontSize="11"/>
                                                <TextBlock Text="Metadatos del Proyecto" FontSize="11"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Botón Actividad de Archivos -->
                                        <Button Command="{Binding SeleccionarAuditoriaArchivosCommand}"
                                                Padding="10,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsAuditoriaArchivosSeleccionada}" Value="True">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁 " FontSize="11"/>
                                                <TextBlock Text="Actividad de Archivos" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- ═══════════════════════════════════════════════════════════
                                     SUBPESTAÑA 1: METADATOS DEL PROYECTO
                                     ═══════════════════════════════════════════════════════════ -->
                                <StackPanel Visibility="{Binding EsAuditoriaProyectoSeleccionada, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Cargando historial de cambios..."
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               FontStyle="Italic" Margin="2"
                                               Visibility="{Binding CargandoHistorial, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="No se encontraron registros de auditoría administrativa para este proyecto."
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               FontStyle="Italic" Margin="2"
                                               Visibility="{Binding HasNoHistorial, Converter={StaticResource BoolToVis}}"/>

                                    <ItemsControl ItemsSource="{Binding HistorialAuditoria}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <DockPanel Grid.Row="0">
                                                            <Border DockPanel.Dock="Left" Background="{Binding AccionBadgeBg}"
                                                                    BorderBrush="{Binding AccionBadgeBorder}" BorderThickness="1"
                                                                    CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding AccionIcono}" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="{Binding Accion}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{Binding AccionBadgeColor}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FechaHoraTexto}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        </DockPanel>

                                                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Usuario}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Equipo, StringFormat='  (💻 {0})'}" FontSize="10.5"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detalles}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontFamily="{StaticResource AppFont}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Botón Ver Más Movimientos (Abre Modal) -->
                                    <Button Command="{Binding VerMasActividadArchivosCommand}"
                                            Visibility="{Binding TieneMasMovimientosArchivos, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource OutlineButton}"
                                            HorizontalAlignment="Stretch"
                                            Padding="10,6" Margin="0,4,0,6"
                                            ToolTip="Abrir ventana modal con el historial completo de movimientos de archivos del proyecto">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TextoVerMasArchivos}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- ═══════════════════════════════════════════════════════════
                                     SUBPESTAÑA 2: ACTIVIDAD DE ARCHIVOS
                                     ═══════════════════════════════════════════════════════════ -->
                                <StackPanel Visibility="{Binding EsAuditoriaArchivosSeleccionada, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Cargando actividad de archivos..."
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               FontStyle="Italic" Margin="2"
                                               Visibility="{Binding CargandoHistorialArchivos, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="No se encontraron cambios ni movimientos de archivos para este proyecto."
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               FontStyle="Italic" Margin="2"
                                               Visibility="{Binding HasNoHistorialArchivos, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Cabecera de movimientos recientes -->
                                    <DockPanel Margin="0,0,0,6" Visibility="{Binding HasHistorialArchivos, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Mostrando los 5 movimientos más recientes:" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#EBF3EE" CornerRadius="4" Padding="5,1" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TotalMovimientosArchivos, StringFormat='Total: {0}'}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource UisGreenBrush}"/>
                                        </Border>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding HistorialArchivos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Encabezado: Badge + Fecha/Hora + Tamaño -->
                                                        <DockPanel Grid.Row="0">
                                                            <Border DockPanel.Dock="Left" Background="{Binding AccionBadgeBg}"
                                                                    BorderBrush="{Binding AccionBadgeBorder}" BorderThickness="1"
                                                                    CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding AccionIcono}" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="{Binding Accion}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{Binding AccionBadgeColor}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TamanoTexto, StringFormat='📦 {0}'}" FontSize="10.5"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding FechaHoraTexto}" FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppFont}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <!-- Ruta relativa del archivo -->
                                                        <TextBlock Grid.Row="1" Text="{Binding RutaRelativa, StringFormat='📁 {0}'}"
                                                                   FontSize="11" FontFamily="Consolas, Segoe UI Mono, monospace"
                                                                   Foreground="{StaticResource UisGreenBrush}" FontWeight="SemiBold"
                                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                                                        <!-- Autoría y detalles -->
                                                        <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Usuario}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Equipo, StringFormat='  (💻 {0})'}" FontSize="10.5"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource AppFont}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detalles}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontFamily="{StaticResource AppFont}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Botón Ver Más Movimientos (Abre Modal) -->
                                    <Button Command="{Binding VerMasActividadArchivosCommand}"
                                            Visibility="{Binding TieneMasMovimientosArchivos, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource OutlineButton}"
                                            HorizontalAlignment="Stretch"
                                            Padding="10,6" Margin="0,4,0,6"
                                            ToolTip="Abrir ventana modal con el historial completo de movimientos de archivos del proyecto">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TextoVerMasArchivos}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     BANNER INFORMATIVO INFERIOR: Estándar ISO 19115
                     ═══════════════════════════════════════════════════════════ -->
                <Border Background="#F2FAF5" BorderBrush="#BEE5CF" BorderThickness="1"
                        CornerRadius="6" Padding="12,9" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🌐" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Ficha técnica de metadatos espaciales estructurada bajo la norma ISO 19115-1:2014 y el Perfil Geográfico Colombiano (ICDE / IGAC). Los archivos físicos y capas del proyecto se exploran y visualizan en el visor geográfico."
                                   FontSize="11" Foreground="#1E6539" FontFamily="{StaticResource AppFont}"
                                   TextWrapping="Wrap" LineHeight="15" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
