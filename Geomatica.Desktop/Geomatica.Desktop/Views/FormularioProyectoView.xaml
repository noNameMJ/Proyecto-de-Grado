<UserControl x:Class="Geomatica.Desktop.Views.FormularioProyectoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}" FocusManager.FocusedElement="{Binding ElementName=txtRuta}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" MaxWidth="820" HorizontalAlignment="Stretch">

                <!-- Título Dinámico (Crear / Editar) -->
                <TextBlock Text="{Binding TituloVista}" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
                <Rectangle Height="3" Width="60" Fill="{StaticResource UisGoldBrush}"
                           HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <!-- Card Formulario -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <!-- Banner informativo si no se tienen permisos de escritura en la carpeta (Modo Edición) -->
                        <Border Visibility="{Binding EsSoloLecturaOAccesoRestringido, Converter={StaticResource BoolToVis}}"
                                Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock Text="🔒" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MensajeRestriccion}" Foreground="#795548" FontSize="12.5"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════
                             SECCIÓN 1: REPOSITORIO DE ARCHIVOS Y METADATOS TÉCNICOS (ISO 19115)
                             (PRIMER CAMPO PARA REGISTRAR / VINCULAR EL PROYECTO)
                             ═══════════════════════════════════════════════════════════ -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="📁 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="1. Repositorio de Archivos y Metadatos Técnicos" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#E8F4EC" BorderBrush="#B2DFBF" BorderThickness="1"
                                    CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="ISO 19115-1:2014" FontSize="10" FontWeight="Bold" Foreground="{StaticResource UisGreenBrush}"/>
                            </Border>
                        </DockPanel>

                        <TextBlock Text="Ruta de Archivos del Proyecto (Carpeta Local o de Red)" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="📂 Seleccionar Carpeta" Command="{Binding SeleccionarCarpetaCommand}"
                                    IsEnabled="{Binding PuedeEscribir}"
                                    Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                                    Margin="8,0,0,0" Padding="14,7" FontSize="12.5"
                                    ToolTip="Seleccionar la carpeta donde se almacenan los archivos espaciales del proyecto"/>
                            <TextBox x:Name="txtRuta" Text="{Binding Ruta, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                     Style="{StaticResource ModernTextBox}"
                                     ToolTip="Ejemplo: D:\Proyectos\Campus_UIS_2024"/>
                        </DockPanel>
                        <TextBlock Text="💡 Al seleccionar la carpeta, el sistema auto-detecta automáticamente los metadatos técnicos (SRID, formatos y linaje)."
                                   Style="{StaticResource HintText}" Margin="0,0,0,12"/>

                        <!-- Sub-panel estilizado: Metadatos Técnicos ISO 19115 -->
                        <Border Background="#F9FBFA" BorderBrush="#D1E7DD" BorderThickness="1" CornerRadius="8"
                                Padding="16,14" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="🌐 " FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Metadatos Espaciales Detectados" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontSemibold}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Command="{Binding ExtraerMetadatosCommand}"
                                            IsEnabled="{Binding PuedeEscribir}"
                                            Style="{StaticResource OutlineButton}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Padding="10,4" FontSize="11"
                                            ToolTip="Explora recursivamente todas las subcarpetas (ej: Datos_Espaciales, Rasters, Vectores) para re-escanear SRID, formato y linaje">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Auto-detectar desde Archivos" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sistema de Referencia (SRID / EPSG)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SistemaReferencia}"
                                                 IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 ToolTip="Ejemplo: EPSG:9377 (MAGNA-SIRGAS Origen Nacional) o EPSG:3116"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Formato de Datos Espaciales" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FormatoDatos}"
                                                 IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 ToolTip="Ejemplo: Vector (Shapefile), Raster (GeoTIFF), File Geodatabase"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Linaje y Calidad de los Datos (Historial de Procesamiento)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Linaje}"
                                         IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="65" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                         ToolTip="Registro de las fuentes originales, transformaciones y procedimientos cartográficos aplicados."/>

                                <TextBlock Text="💡 Búsqueda profunda en subcarpetas especializadas (Datos_Espaciales, Entregables), identificando sistemas de coordenadas (.prj con regex EPSG) y tipos de capas."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Border>

                        <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,0,16"/>

                        <!-- ═══════════════════════════════════════════════════════════
                             SECCIÓN 2: IDENTIFICACIÓN Y DESCRIPCIÓN DEL PROYECTO
                             ═══════════════════════════════════════════════════════════ -->
                        <TextBlock Text="2. Identificación y Descripción" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Título del Proyecto *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtTitulo" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,2"/>
                        <TextBlock Text="El título es obligatorio" Style="{StaticResource ValidationErrorText}"
                                   Visibility="{Binding TituloInvalido, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10"/>

                        <TextBlock Text="Descripción / Resumen (Opcional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Descripcion}"
                                 IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                 Height="70" AcceptsReturn="True"
                                 TextWrapping="Wrap" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Fecha de Inicio" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding FechaInicio}"
                                            IsEnabled="{Binding PuedeEscribir}"
                                            HorizontalAlignment="Left" Width="200" Margin="0,0,0,14"/>
                            </StackPanel>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,0" Width="200">
                                    <Button Command="{Binding LimpiarFechaFinCommand}"
                                            IsEnabled="{Binding PuedeEscribir}"
                                            Style="{StaticResource GhostButton}"
                                            Content="✕" FontSize="10" Padding="3,0" Margin="4,0,0,0"
                                            ToolTip="Limpiar fecha de finalización" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Fecha de Finalización (Opcional)" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <DatePicker SelectedDate="{Binding FechaFin}"
                                            IsEnabled="{Binding PuedeEscribir}"
                                            HorizontalAlignment="Left" Width="200" Margin="0,0,0,14"/>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Representante / Responsable (Opcional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Representante}"
                                         IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                         Width="230" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"
                                         ToolTip="Nombre del líder técnico, docente o representante"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Entidades Vinculadas (Opcional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Entidades}"
                                         IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                         Width="230" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"
                                         ToolTip="Instituciones o contrapartes (ej: UIS, IGAC, Gobernación)"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Palabras Clave (Etiquetas)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Separe los términos con comas (,). Ejemplo: topografía, fotogrametría, lidar, ortomosaico, campus uis"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding PalabraClave}"
                                 IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                        <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,0,16"/>

                        <!-- ═══════════════════════════════════════════════════════════
                             SECCIÓN 3: LOCALIZACIÓN GEOGRÁFICA Y TERRITORIAL
                             ═══════════════════════════════════════════════════════════ -->
                        <TextBlock Text="3. Localización Geográfica y Territorial" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Departamentos}"
                                          SelectedItem="{Binding SelectedDepartamento}"
                                          IsEnabled="{Binding PuedeEscribir}"
                                          DisplayMemberPath="Nombre" MinWidth="200"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Municipio" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Municipios}"
                                          SelectedItem="{Binding SelectedMunicipio}"
                                          IsEnabled="{Binding PuedeEscribir}"
                                          DisplayMemberPath="Nombre" MinWidth="200"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Button Content="➕ Agregar Municipio"
                                        Command="{Binding AgregarMunicipioCommand}"
                                        IsEnabled="{Binding PuedeEscribir}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7" FontSize="12" Margin="0,0,8,0"
                                        ToolTip="Asociar este municipio al proyecto (permite proyectos multimunicipales o multidepartamentales)"/>
                                <Button Content="🗺️ + Todo el Dpto."
                                        Command="{Binding AgregarTodoDepartamentoCommand}"
                                        IsEnabled="{Binding PuedeEscribir}"
                                        Style="{StaticResource OutlineButton}"
                                        Padding="10,7" FontSize="12"
                                        ToolTip="Asociar todos los municipios del departamento seleccionado al proyecto"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Lista de chips de municipios asociados (soporte multidepartamental / multimunicipal) -->
                        <Border Background="#F9FBFA" BorderBrush="#D1E7DD" BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="📍 Municipios / Departamentos Asociados al Proyecto:" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ResumenMunicipiosSeleccionados}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"
                                               TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>

                                <ItemsControl x:Name="icMunicipiosSeleccionados"
                                              ItemsSource="{Binding MunicipiosSeleccionados}"
                                              Visibility="{Binding HasMunicipiosSeleccionados, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F4EC" BorderBrush="#B2DFBF" BorderThickness="1"
                                                    CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EtiquetaCompleta}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="#1A5C34" VerticalAlignment="Center"/>
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.QuitarMunicipioCommand, ElementName=icMunicipiosSeleccionados}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.PuedeEscribir, ElementName=icMunicipiosSeleccionados}"
                                                            Style="{StaticResource GhostButton}"
                                                            FontSize="10" FontWeight="Bold" Foreground="#1A5C34"
                                                            Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            ToolTip="Quitar este municipio del proyecto"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Coordenadas Geográficas (Opcional — WGS84)" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Latitud" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LatStr}"
                                         IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                         Width="150" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Longitud" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LonStr}"
                                         IsReadOnly="{Binding EsSoloLecturaOAccesoRestringido}"
                                         Width="150" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="O haga clic en el mapa para ubicar el punto territorial:"
                                   Style="{StaticResource HintText}" Margin="0,-8,0,6"/>
                        <Border CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" ClipToBounds="True" Height="250" Margin="0,0,0,14">
                            <esri:MapView x:Name="pickerMapView"/>
                        </Border>
                        <TextBlock Text="Si se dejan vacíos, se conservará la geometría previa o se asignará el polígono municipal."
                                   Style="{StaticResource HintText}" Margin="0,0,0,14"/>

                        <!-- ═══════════════════════════════════════════════════════════
                             SECCIÓN 4: SUBPROYECTOS Y FRENTES DE TRABAJO
                             ═══════════════════════════════════════════════════════════ -->
                        <Separator Margin="0,18,0,16" Background="{StaticResource BorderSubtleBrush}"/>

                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="📍 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="4. Subproyectos y Frentes de Trabajo" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#EBF3EE" BorderBrush="#B2DFBF" BorderThickness="1"
                                        CornerRadius="10" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalSubproyectos, StringFormat='{}{0} registrados'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource UisGreenBrush}"/>
                                </Border>

                                <Button Content="📋 Ver como Tabla"
                                        Command="{Binding AbrirEditorTablaSubproyectosCommand}"
                                        IsEnabled="{Binding PuedeEscribir}"
                                        Style="{StaticResource OutlineButton}"
                                        Padding="8,4" Margin="0,0,6,0" FontSize="11"
                                        ToolTip="Ver, modificar, agregar y validar subproyectos en formato tabla o cargar desde CSV/TXT"/>

                                <Button Content="➕ Agregar Subproyecto"
                                        Command="{Binding MostrarFormularioSubproyectoCommand}"
                                        IsEnabled="{Binding PuedeEscribir}"
                                        Style="{StaticResource OutlineButton}"
                                        Padding="10,4" FontSize="11.5"
                                        ToolTip="Vincular un subproyecto, frente de obra o sector específico mediante una ventana emergente"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Permite asociar frentes de trabajo, tramos, estaciones, sectores o sitios específicos con subcarpeta propia y ubicación física en el territorio."
                                   Style="{StaticResource HintText}" Margin="0,0,0,12"/>


                        <!-- Estado Vacío cuando no hay subproyectos -->
                        <Border Visibility="{Binding NoHaySubproyectos, Converter={StaticResource BoolToVis}}"
                                Background="#FAFAFA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📍" FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="No hay subproyectos ni frentes de trabajo registrados. Si el proyecto cuenta con múltiples sitios o sectores de obra, use el botón '➕ Agregar Subproyecto'."
                                           Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Lista de Subproyectos Registrados -->
                        <ItemsControl ItemsSource="{Binding Subproyectos}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="🎯 Ubicar"
                                                        Command="{Binding DataContext.UbicarSubproyectoEnMapaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="6,4" Margin="0,0,4,0" FontSize="11"
                                                        ToolTip="Centrar y visualizar este subproyecto en el mapa"/>

                                                <Button Content="✏️ Editar"
                                                        Command="{Binding DataContext.EditarSubproyectoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.PuedeEscribir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="6,4" Margin="0,0,4,0" FontSize="11"
                                                        ToolTip="Editar datos, territorio, coordenadas y subcarpeta de este subproyecto en una ventana emergente"/>

                                                <Button Content="🗑️"
                                                        Command="{Binding DataContext.QuitarSubproyectoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.PuedeEscribir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="6,4" FontSize="11"
                                                        ToolTip="Quitar este subproyecto"/>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📍" Foreground="{StaticResource UisGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Visibility="{Binding EsNuevo, Converter={StaticResource BoolToVis}}"
                                                            Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1"
                                                            CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Pendiente por guardar" FontSize="10" FontWeight="SemiBold" Foreground="#856404"/>
                                                    </Border>
                                                    <Border Visibility="{Binding EsModificadoExistente, Converter={StaticResource BoolToVis}}"
                                                            Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1"
                                                            CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Modificado" FontSize="10" FontWeight="SemiBold" Foreground="#0369A1"/>
                                                    </Border>
                                                </StackPanel>

                                                <WrapPanel Margin="0,4,0,0">
                                                    <TextBlock Text="🏛️ " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MunicipioTexto}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                                    <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Subcarpeta}" FontSize="11.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                                    <TextBlock Text="🌐 " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CoordenadasTexto}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding Descripcion}"
                                                           Visibility="{Binding HasDescripcion, Converter={StaticResource BoolToVis}}"
                                                           FontStyle="Italic" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ═══════════════════════════════════════════════════════════
                             ACCIONES DE GUARDADO / EDICIÓN / ELIMINACIÓN
                             ═══════════════════════════════════════════════════════════ -->
                        <DockPanel Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}"
                                        IsEnabled="{Binding PuedeEscribir}"
                                        ToolTip="{Binding TooltipGuardar}"
                                        Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                                        Style="{StaticResource OutlineButton}" Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- Botón de eliminación visible únicamente en modo edición -->
                            <Button Content="🗑️ Eliminar Proyecto" Command="{Binding EliminarCommand}"
                                    IsEnabled="{Binding PuedeEliminar}"
                                    ToolTip="{Binding TooltipEliminar}"
                                    Visibility="{Binding EsModoEdicion, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource DangerButton}" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"/>
                        </DockPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
