<UserControl x:Class="Geomatica.Desktop.Views.MapaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
             xmlns:vm="clr-namespace:Geomatica.Desktop.ViewModels"
             xmlns:views="clr-namespace:Geomatica.Desktop.Views"
             xmlns:esriTK="clr-namespace:Esri.ArcGISRuntime.Toolkit.UI.Controls;assembly=Esri.ArcGISRuntime.Toolkit.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IntToVis" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CapasAdicionales.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HasCapasToVis" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CapasAdicionales.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoCapasToVis" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CapasAdicionales.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral izquierdo: Filtros -->
        <views:BarraFiltrosView Grid.Column="0" DataContext="{Binding Filtros}" />

        <!-- Zona de mapa y archivos -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowMapa" Height="*" MinHeight="60"/>
                <RowDefinition x:Name="RowSplitter" Height="Auto"/>
                <RowDefinition x:Name="RowArchivos" Height="0" MinHeight="0"/>
            </Grid.RowDefinitions>

            <!-- Visor Geográfico (2D MapView / 3D SceneView) -->
            <Grid Grid.Row="0">
                <!-- Visor 2D (MapView) -->
                <esri:MapView x:Name="controlMapView" Map="{Binding Map}">
                    <esri:MapView.Style>
                        <Style TargetType="esri:MapView">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModo3D}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </esri:MapView.Style>
                </esri:MapView>

                <!-- Visor 3D (SceneView) -->
                <esri:SceneView x:Name="controlSceneView" Scene="{Binding Scene}">
                    <esri:SceneView.Style>
                        <Style TargetType="esri:SceneView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModo3D}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </esri:SceneView.Style>
                </esri:SceneView>

                <!-- Banner Flotante de Aviso Sin Conexión a Internet -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                        CornerRadius="8" Padding="14,8"
                        Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1"
                        Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsSinConexionInternet, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Modo Sin Conexión a Internet" FontWeight="Bold" FontSize="11"
                                       Foreground="#856404" FontFamily="{StaticResource AppFont}"/>
                            <TextBlock Text="{Binding AvisoSinConexionTexto}" FontSize="10"
                                       Foreground="#856404" FontFamily="{StaticResource AppFont}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Leyenda — ArcGIS Runtime Toolkit (Solo en 2D) -->
                <Border Background="#E8FFFFFF" CornerRadius="6" Padding="12,10"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,42"
                        BorderBrush="#20000000" BorderThickness="1"
                        MaxHeight="300" MaxWidth="240"
                        Effect="{StaticResource CardShadow}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModo3D}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Leyenda" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource AppFont}" Margin="0,0,0,6"/>
                            <esriTK:Legend GeoView="{Binding ElementName=controlMapView}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Panel Flotante de Control 3D y Estadísticas de Nube de Puntos (Solo en 3D) -->
                <Border Background="#F9FFFFFF" CornerRadius="8" Padding="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0"
                        BorderBrush="#30000000" BorderThickness="1"
                        Width="320" MaxHeight="620"
                        Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsModo3D, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Cabecera -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="🌐 Visor 3D Activo" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                <Border Background="#E6F4EA" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="Relieve 3D ON" FontSize="9" FontWeight="Bold" Foreground="{StaticResource UisGreenBrush}"/>
                                </Border>
                            </DockPanel>

                            <!-- Controles Rápidos de Cámara -->
                            <TextBlock Text="Cámara y Orientación" FontSize="10" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Content="📐 45°" ToolTip="Perspectiva inclinada a 45°"
                                        Style="{StaticResource OutlineButton}" Padding="4,4" FontSize="11" Margin="0,0,2,0"
                                        Command="{Binding InclinarCamara45Command}"/>
                                <Button Content="⬇️ Cenital" ToolTip="Vista cenital vertical (90°)"
                                        Style="{StaticResource OutlineButton}" Padding="4,4" FontSize="11" Margin="2,0,2,0"
                                        Command="{Binding InclinarCamaraCenitalCommand}"/>
                                <Button Content="🧭 Norte" ToolTip="Alinear hacia el Norte geográfico"
                                        Style="{StaticResource OutlineButton}" Padding="4,4" FontSize="11" Margin="2,0,0,0"
                                        Command="{Binding ResetearCamara3DCommand}"/>
                            </UniformGrid>

                            <!-- Zona Activa de Nube de Puntos (Solo cuando hay capa 3D cargada) -->
                            <StackPanel Visibility="{Binding HasCapa3DActiva, Converter={StaticResource BoolToVis}}">
                                <!-- Selector de Capa Activa (Visible cuando hay más de una capa 3D cargada) -->
                                <Border Background="#EBF3FB" CornerRadius="6" Padding="8,6" Margin="0,0,0,8"
                                        BorderBrush="#CCE0F5" BorderThickness="1"
                                        Visibility="{Binding HasMultiplesCapas3D, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Capa 3D Activa:" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#1A5276" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Capas3D.Count, StringFormat={}({0} capas cargadas)}" FontSize="9"
                                                       Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding Capas3D}" SelectedItem="{Binding Capa3DSeleccionada, Mode=TwoWay}"
                                                  DisplayMemberPath="Nombre" FontSize="11" Padding="6,3" Background="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botón Principal: Centrar en Nube -->
                                <Button Content="🎯 Centrar en la Nube" 
                                        ToolTip="Enfoca y centra la nube de puntos seleccionada directamente en el visor"
                                        Style="{StaticResource PrimaryButton}" Padding="8,6" FontSize="12" Margin="0,0,0,8"
                                        Command="{Binding ZoomCapa3DCommand}"/>

                                <!-- Control de Tamaño de Puntos -->
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock Text="Tamaño de Punto:" FontSize="10" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="➖" Command="{Binding DisminuirTamanoPuntos3DCommand}"
                                                    ToolTip="Disminuir tamaño de los puntos 3D"
                                                    Width="24" Height="20" Padding="0" Margin="0,0,4,0"
                                                    Style="{StaticResource OutlineButton}" FontSize="9"/>
                                            <TextBlock Text="{Binding TamanoPunto3D, StringFormat={}{0:F0} px}" 
                                                       FontSize="11" FontWeight="Bold" Width="36" TextAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Button Content="➕" Command="{Binding AumentarTamanoPuntos3DCommand}"
                                                    ToolTip="Aumentar tamaño de los puntos 3D"
                                                    Width="24" Height="20" Padding="0" Margin="4,0,0,0"
                                                    Style="{StaticResource OutlineButton}" FontSize="9"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Control de Elevación / Desfase Z -->
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Desfase Altura (Z):" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OffsetZ3D, StringFormat={}{0:+#;-#;0} m}" 
                                                       FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"
                                                       Foreground="{StaticResource UisGreenBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <UniformGrid Columns="3">
                                            <Button Content="▲ +25m" Command="{Binding SubirAltura3DCommand}"
                                                    ToolTip="Eleva la nube 25 m si quedó bajo el relieve topográfico"
                                                    Style="{StaticResource OutlineButton}" Padding="2,3" FontSize="10" Margin="0,0,2,0"/>
                                            <Button Content="▼ -25m" Command="{Binding BajarAltura3DCommand}"
                                                    ToolTip="Baja la nube 25 m si quedó flotando demasiado alta"
                                                    Style="{StaticResource OutlineButton}" Padding="2,3" FontSize="10" Margin="2,0,2,0"/>
                                            <Button Content="↺ 0m" Command="{Binding ResetearAltura3DCommand}"
                                                    ToolTip="Restablece la cota Z original del archivo"
                                                    Style="{StaticResource OutlineButton}" Padding="2,3" FontSize="10" Margin="2,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Tarjeta Informativa de Nube de Puntos -->
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="☁️ " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TituloCapa3D}" FontWeight="Bold" FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <!-- Badge de Sistema de Coordenadas -->
                                        <Border Background="#E8F4FD" CornerRadius="4" Padding="6,3" Margin="0,2,0,6"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CrsDetectado3D, StringFormat={}🌐 {0}}" FontSize="9" 
                                                       FontWeight="SemiBold" Foreground="#0B5394" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <TextBlock Text="{Binding InfoCapa3DTexto}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                        <Border Background="#FFF9DB" CornerRadius="4" Padding="6,3" Margin="0,6,0,0">
                                            <TextBlock Text="🟡 Marco dorado en el terreno delimita el área levantada." 
                                                       FontSize="9" Foreground="#856404" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Instrucciones de Navegación 3D -->
                            <TextBlock Text="Tip: Clic derecho sostenido para rotar e inclinar la vista 3D libremente."
                                       FontSize="9" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Barra de Herramientas Flotante del Mapa (Esquina Superior Derecha) -->
                <Border Background="#F9FFFFFF" CornerRadius="6" Padding="4"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                        BorderBrush="#20000000" BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel Orientation="Vertical">
                        <!-- Conmutador 2D / 3D -->
                        <Button Content="{Binding Modo3DTextoIcono}" ToolTip="Alternar entre Visor 2D y Visor 3D"
                                Style="{StaticResource MapToolButton}" Margin="0,0,0,4"
                                Command="{Binding ToggleModo3DCommand}" FontWeight="Bold" FontSize="11"/>

                        <Button Content="🗺️" ToolTip="Galería de Mapas Base (Online y Offline)"
                                Style="{StaticResource MapToolButton}" Margin="0,0,0,4"
                                Command="{Binding ToggleSelectorMapasBaseCommand}"/>

                        <!-- Botón de Capas Añadidas con Insignia de Conteo -->
                        <Grid Margin="0,0,0,4">
                            <Button Content="📑" ToolTip="Capas Añadidas al Mapa (Opacidad, Visibilidad y Zoom)"
                                    Style="{StaticResource MapToolButton}"
                                    Command="{Binding TogglePanelCapasCommand}"/>
                            <Border Background="{StaticResource UisGreenBrush}" CornerRadius="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                    Padding="4,1" MinWidth="14" Style="{StaticResource IntToVis}">
                                <TextBlock Text="{Binding CapasAdicionales.Count}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                                
                        <Button Content="📐" ToolTip="Herramientas de Medición SIG (Distancia y Área)"
                                Style="{StaticResource MapToolButton}" Margin="0,0,0,4"
                                Command="{Binding ToggleHerramientasMedicionCommand}"/>
                                
                        <Button x:Name="HomeButton" Content="🏠" ToolTip="Restaurar vista inicial (Colombia)"
                                Style="{StaticResource MapToolButton}"
                                Command="{Binding HomeCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Panel Flotante de Capas Añadidas (UX/UI Moderna con Opacidad y Visibilidad) -->
                <Border Background="#F9FFFFFF" CornerRadius="8" Padding="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,76,0"
                        BorderBrush="#30000000" BorderThickness="1"
                        Width="360" MaxHeight="520"
                        Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsPanelCapasVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header con título, badge y botones de acción -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Capas Añadidas" FontWeight="Bold" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource AppFont}"/>
                                <Border Background="{StaticResource UisGreenBrush}" CornerRadius="10" Padding="6,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Style="{StaticResource IntToVis}">
                                    <TextBlock Text="{Binding CapasAdicionales.Count}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Limpiar todo" Command="{Binding QuitarTodasLasCapasCommand}"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                        FontSize="11" Cursor="Hand" Padding="4" Margin="0,0,6,0"
                                        ToolTip="Quitar todas las capas añadidas del mapa"
                                        Style="{StaticResource HasCapasToVis}"/>
                                <Button Content="✕" Command="{Binding TogglePanelCapasCommand}"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="12" Cursor="Hand" Padding="4"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Contenido: Estado vacío o Lista de capas -->
                        <Grid Grid.Row="1">
                            <!-- Estado vacío cuando no hay capas -->
                            <StackPanel Style="{StaticResource NoCapasToVis}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,32">
                                <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.6"/>
                                <TextBlock Text="No hay capas añadidas" FontWeight="SemiBold" FontSize="13" 
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Haga doble clic en archivos ráster (.tif) o vectoriales (.shp) en el explorador de archivos para visualizarlos en el mapa." 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="280"/>
                            </StackPanel>

                            <!-- Lista interactiva de capas -->
                            <ScrollViewer Style="{StaticResource HasCapasToVis}" VerticalScrollBarVisibility="Auto" MaxHeight="430">
                                <ItemsControl ItemsSource="{Binding CapasAdicionales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" CornerRadius="6" Padding="10,8"
                                                    Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <!-- Fila Superior: Visibilidad, Icono, Nombre y Acciones -->
                                                    <DockPanel LastChildFill="True">
                                                        <!-- Botón Quitar (✕) -->
                                                        <Button Content="✕" Command="{Binding QuitarCommand}" DockPanel.Dock="Right"
                                                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource ErrorBrush}"
                                                                ToolTip="Quitar capa del visor"
                                                                FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" Padding="4,2" Margin="4,0,0,0"/>

                                                        <!-- Botón Centrar (🔍 Zoom) -->
                                                        <Button Content="🔍" Command="{Binding ZoomCommand}" DockPanel.Dock="Right"
                                                                Background="Transparent" BorderThickness="0"
                                                                ToolTip="Centrar extensión en el mapa"
                                                                FontSize="12" VerticalAlignment="Center" Cursor="Hand" Padding="4,2"/>

                                                        <!-- CheckBox Visibilidad (Mostrar / Ocultar) -->
                                                        <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" DockPanel.Dock="Left"
                                                                  ToolTip="Mostrar / Ocultar capa" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <!-- Icono de tipo de capa -->
                                                        <TextBlock Text="{Binding TipoIcono}" FontSize="14" DockPanel.Dock="Left"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <!-- Nombre de archivo y tipo -->
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding RutaCompleta}"/>
                                                            <TextBlock Text="{Binding TipoTexto}" FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontFamily="{StaticResource AppFont}"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Fila Inferior: Control de Opacidad / Transparencia -->
                                                    <DockPanel Margin="0,8,0,0">
                                                        <TextBlock Text="Opacidad:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Opacidad, StringFormat={}{0:P0}}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Right"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0" Width="36" TextAlignment="Right"/>
                                                        <Slider Value="{Binding Opacidad, Mode=TwoWay}" Minimum="0.0" Maximum="1.0"
                                                                SmallChange="0.01" LargeChange="0.05"
                                                                IsMoveToPointEnabled="True"
                                                                TickFrequency="0.05" IsSnapToTickEnabled="False"
                                                                VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Galería / Selector Flotante de Mapas Base -->
                <Border Background="#F9FFFFFF" CornerRadius="8" Padding="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,76,0"
                        BorderBrush="#30000000" BorderThickness="1"
                        Width="360" MaxHeight="520"
                        Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsSelectorMapasBaseVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Encabezado con título y botón cerrar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Mapas Base" FontWeight="Bold" FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding ToggleSelectorMapasBaseCommand}" DockPanel.Dock="Right"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="12" Cursor="Hand" Padding="4" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Conmutador de Modo Offline -->
                        <Border Grid.Row="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModoOfflineForzado}" Value="True">
                                            <Setter Property="Background" Value="#E6F4EA"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource UisGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSinConexionInternet}" Value="True">
                                            <Setter Property="Background" Value="#FFF3CD"/>
                                            <Setter Property="BorderBrush" Value="#FFEEBA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🔌 Modo Sin Conexión (Offline)" FontWeight="SemiBold" FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Estado: En línea (servicios en la nube)"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModoOfflineForzado}" Value="True">
                                                        <Setter Property="Text" Value="Estado: Modo Offline (paquete local predeterminado)"/>
                                                        <Setter Property="Foreground" Value="{StaticResource UisGreenBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSinConexionInternet}" Value="True">
                                                        <Setter Property="Text" Value="Estado: Sin conexión detectada"/>
                                                        <Setter Property="Foreground" Value="#856404"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsModoOfflineForzado, Mode=TwoWay}"
                                          DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ToolTip="Activar para forzar uso exclusivo del mapa base local predeterminado"/>
                            </DockPanel>
                        </Border>

                        <!-- Lista de Mapas Base -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <ItemsControl ItemsSource="{Binding MapasBase}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="6" Padding="10,8"
                                                BorderThickness="1.5"
                                                IsEnabled="{Binding IsHabilitado}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeleccionado}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource UisGreenBrush}"/>
                                                            <Setter Property="Background" Value="#F2FAF5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHabilitado}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                            <Setter Property="Background" Value="#F8F9FA"/>
                                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                            <Setter Property="Cursor" Value="No"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.CambiarMapaBaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icono -->
                                                <TextBlock Grid.Column="0" Text="{Binding Icono}" FontSize="20" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Textos y Badges -->
                                                <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="12" 
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontFamily="{StaticResource AppFont}"/>

                                                        <!-- Badge: Offline Predeterminado -->
                                                        <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3" Background="#E6F4EA"
                                                                Visibility="{Binding IsDefaultOffline, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Offline Predeterminado" FontSize="9" FontWeight="Bold" Foreground="{StaticResource UisGreenBrush}"/>
                                                        </Border>

                                                        <!-- Badge: Estado Online / Solo Online -->
                                                        <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F1F3F4"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefaultOffline}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsHabilitado}" Value="False">
                                                                            <Setter Property="Background" Value="#FCE8E6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="9">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Requiere Internet"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHabilitado}" Value="False">
                                                                                <Setter Property="Text" Value="Solo Online"/>
                                                                                <Setter Property="Foreground" Value="#C5221F"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding Descripcion}" FontSize="11" 
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="{StaticResource AppFont}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Indicador de Seleccionado (Checkmark) -->
                                                <TextBlock Grid.Column="2" Text="✓" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource UisGreenBrush}"
                                                           VerticalAlignment="Center" Margin="4,0,2,0"
                                                           Visibility="{Binding IsSeleccionado, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Panel Flotante de Herramientas de Medición SIG -->
                <Border Background="#F9FFFFFF" CornerRadius="8" Padding="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,76,0"
                        BorderBrush="#30000000" BorderThickness="1"
                        Width="320"
                        Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsHerramientasMedicionVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Medición SIG" FontWeight="Bold" FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding ToggleHerramientasMedicionCommand}" DockPanel.Dock="Right"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="12" Cursor="Hand" Padding="4" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Botones de modo de medición -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Button Content="📏 Distancia" Command="{Binding ActivarMedicionDistanciaCommand}"
                                    Style="{StaticResource OutlineButton}" Margin="0,0,4,0" Padding="8,6" FontSize="12"/>
                            <Button Content="📐 Área" Command="{Binding ActivarMedicionAreaCommand}"
                                    Style="{StaticResource OutlineButton}" Margin="4,0,0,0" Padding="8,6" FontSize="12"/>
                        </UniformGrid>

                        <!-- Tarjeta de Resultados -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasResultadoMedicion, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Resultado:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ResultadoMedicion}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource UisGreenBrush}" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding DetalleMedicion}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Botones de Acción de Medición -->
                        <DockPanel>
                            <Button Content="📋 Copiar" Command="{Binding CopiarMedicionCommand}"
                                    Style="{StaticResource GhostButton}" FontSize="11" Padding="8,4" HorizontalAlignment="Left"
                                    Visibility="{Binding HasResultadoMedicion, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="🗑️ Limpiar" Command="{Binding LimpiarMedicionCommand}"
                                    Style="{StaticResource GhostButton}" FontSize="11" Padding="8,4" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Barra de Estado Inferior: Coordenadas del Cursor y Escala -->
                <Border Background="#D0000000" CornerRadius="4" Padding="12,4"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,8"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CoordenadasCursorTexto}" Foreground="White" FontSize="11" 
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Rectangle Width="1" Height="12" Fill="#50FFFFFF" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EscalaMapaTexto}" Foreground="#E0E0E0" FontSize="11" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="gridSplitterArchivos" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" 
                          Background="{StaticResource SeparatorBrush}" Visibility="Collapsed" />

            <!-- Archivos -->
            <Grid x:Name="panelArchivos" Grid.Row="2" Background="{StaticResource PanelBrush}"
                  Visibility="Collapsed">
                <!-- Usamos el ContentControl para mostrar ArchivosView -->
                <views:ArchivosView DataContext="{Binding ArchivosVM}" />
            </Grid>
        </Grid>

        <!-- Panel lateral derecho: Detalle del proyecto -->
        <Border x:Name="panelDetalle" Grid.Column="2" Width="360" MinWidth="320" MaxWidth="480" Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <views:FichaProyectoView DataContext="{Binding ArchivosVM.ProyectoDetalle}"/>
        </Border>
    </Grid>
</UserControl>
