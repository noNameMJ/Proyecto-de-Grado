<Window x:Class="Geomatica.Desktop.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GEOMÁTICA UIS — Cargando"
        Height="360" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Colores y Fuentes Institucionales UIS (autocontenidos para inicio inmediato) -->
        <SolidColorBrush x:Key="UisGreenBrush" Color="#006633"/>
        <SolidColorBrush x:Key="UisGoldBrush" Color="#D4A017"/>
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

        <!-- Estilo suave y moderno para la barra de progreso -->
        <Style x:Key="SplashProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource UisGoldBrush}"/>
            <Setter Property="Background" Value="#323236"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <!-- Tarjeta Flotante con DropShadow -->
        <Border Background="#1E1E1E"
                CornerRadius="8"
                BorderBrush="#383838"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>   <!-- Franja Dorada UIS -->
                    <RowDefinition Height="*"/>   <!-- Cuerpo Principal -->
                    <RowDefinition Height="34"/>  <!-- Barra Inferior de Estado Institucional -->
                </Grid.RowDefinitions>

                <!-- Franja Dorada UIS -->
                <Rectangle Grid.Row="0" Fill="{StaticResource UisGoldBrush}"/>

                <!-- Cuerpo Principal -->
                <Grid Grid.Row="1" Margin="32,24,32,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado con Logo Institucional UIS -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <!-- Emblema Circular 'G' -->
                        <Grid Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,16,0">
                            <Ellipse Fill="{StaticResource UisGreenBrush}"/>
                            <Ellipse Stroke="{StaticResource UisGoldBrush}" StrokeThickness="2" Margin="1"/>
                            <TextBlock Text="G" Foreground="White" FontWeight="Bold" FontSize="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"/>
                        </Grid>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GEOMÁTICA" Foreground="{StaticResource UisGoldBrush}"
                                           FontSize="22" FontWeight="Bold"
                                           FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Text="UIS" Foreground="White"
                                           FontSize="22" FontWeight="Light" Margin="8,0,0,0"
                                           FontFamily="{StaticResource AppFont}"/>
                            </StackPanel>
                            <TextBlock Text="SISTEMA DE GESTIÓN Y VISOR INSTITUCIONAL DE PROYECTOS"
                                       Foreground="#A0A0A0" FontSize="9.5" FontWeight="SemiBold"
                                       Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Zona Central: Estado y Progreso -->
                    <Border Grid.Row="2" Background="#262629" CornerRadius="6"
                            BorderBrush="#38383C" BorderThickness="1"
                            Padding="16,14">
                        <StackPanel>
                            <!-- Estado y Porcentaje -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock x:Name="TxtPorcentaje" Text="" DockPanel.Dock="Right"
                                           Foreground="{StaticResource UisGoldBrush}"
                                           FontSize="12" FontWeight="Bold"
                                           FontFamily="{StaticResource AppFont}"/>
                                <TextBlock x:Name="TxtEstado" Text="Iniciando sistema..."
                                           Foreground="#F0F0F0" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource AppFont}"/>
                            </DockPanel>

                            <!-- Detalle secundario -->
                            <TextBlock x:Name="TxtDetalle" Text="Cargando configuración institucional..."
                                       Foreground="#8E8E93" FontSize="11" Margin="0,0,0,10"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource AppFont}"/>

                            <!-- Barra de progreso con esquinas redondeadas -->
                            <Border CornerRadius="2.5" ClipToBounds="True" Height="5">
                                <ProgressBar x:Name="ProgresoBar"
                                             Style="{StaticResource SplashProgressBarStyle}"
                                             IsIndeterminate="True" Minimum="0" Maximum="100"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Barra Inferior Institucional -->
                <Border Grid.Row="2" Background="#141414" BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="24,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="Universidad Industrial de Santander • Escuela de Ingenierías"
                                   Foreground="#6E6E6E" FontSize="10"
                                   FontFamily="{StaticResource AppFont}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Versión 2.0 • 2026"
                                   Foreground="#888888" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource AppFont}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
