<Window x:Class="Geomatica.Desktop.Views.TablaAtributosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabla de Atributos" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#F8F9FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Button Content="✕ Cerrar" Click="BtnCerrar_Click" DockPanel.Dock="Right"
                    Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC"
                    Foreground="#555555" Padding="12,6" Cursor="Hand" Margin="8,0,0,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="💾 Exportar CSV" Click="BtnExportarCsv_Click" DockPanel.Dock="Right"
                    Background="#FFFFFF" BorderThickness="1" BorderBrush="#1B5E20"
                    Foreground="#1B5E20" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" Margin="8,0,0,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtIcono" Text="📊" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="TxtTitulo" Text="Tabla de Atributos" FontWeight="Bold" FontSize="16" Foreground="#212121"/>
                    <TextBlock x:Name="TxtSubtitulo" Text="0 registros" FontSize="11" Foreground="#757575"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Barra de búsqueda y filtrado rápido -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="TxtBuscar" Padding="8,6" FontSize="13" TextChanged="TxtBuscar_TextChanged"
                     BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="🔍 Buscar en todas las columnas..." IsHitTestVisible="False"
                       Foreground="#9E9E9E" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding Text.IsEmpty, ElementName=TxtBuscar, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- DataGrid Virtualizado -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="GridAtributos" AutoGenerateColumns="True" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAEAEA" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent"
                      MouseDoubleClick="GridAtributos_MouseDoubleClick"
                      SelectionChanged="GridAtributos_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F4F1"/>
                        <Setter Property="Foreground" Value="#1B5E20"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Height" Value="28"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Barra inferior: Información de selección y acciones -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnVerFotos" Content="📷 Ver fotografías..." Click="BtnVerFotos_Click"
                        Background="#FFFFFF" BorderThickness="1" BorderBrush="#00796B" Foreground="#00796B" FontWeight="SemiBold"
                        Padding="12,6" Cursor="Hand" Margin="0,0,8,0" Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnCentrar" Content="🔍 Centrar elemento en mapa" Click="BtnCentrar_Click"
                        Background="#1B5E20" Foreground="White" FontWeight="SemiBold"
                        Padding="14,6" Cursor="Hand" IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <TextBlock x:Name="TxtInfoSeleccion" Text="Seleccione una fila para interactuar con el mapa."
                       FontSize="11" Foreground="#616161" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>

