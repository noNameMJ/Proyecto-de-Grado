<Window x:Class="Geomatica.Desktop.Views.VisorFotoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visor de Fotografías de Árboles" Height="700" Width="900"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#18181B"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="NavOverlayButton" TargetType="Button">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="True">
                <Button Content="✕ Cerrar" Click="BtnCerrar_Click" DockPanel.Dock="Right"
                        Background="#3F3F46" BorderThickness="0" Foreground="#E4E4E7"
                        Padding="14,6" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌳" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitulo" Text="Fotografías del Árbol" FontWeight="Bold" FontSize="16" Foreground="#F4F4F5"/>
                        <TextBlock x:Name="TxtSubtitulo" Text="Cargando detalles..." FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Área principal de visualización de imagen -->
        <Grid Grid.Row="1" Background="#09090B">
            <Image x:Name="ImgPrincipal" Stretch="Uniform" Margin="16"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Botón de navegación Anterior -->
            <Button x:Name="BtnAnterior" Style="{StaticResource NavOverlayButton}" Content="◀"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                    Click="BtnAnterior_Click" ToolTip="Fotografía anterior (Tecla Flecha Izquierda)"/>

            <!-- Botón de navegación Siguiente -->
            <Button x:Name="BtnSiguiente" Style="{StaticResource NavOverlayButton}" Content="▶"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                    Click="BtnSiguiente_Click" ToolTip="Siguiente fotografía (Tecla Flecha Derecha)"/>

            <!-- Mensaje de no disponible -->
            <TextBlock x:Name="TxtSinImagen" Text="No fue posible cargar la imagen seleccionada."
                       Foreground="#A1A1AA" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Carrusel de miniaturas -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,1" Padding="12,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ListBox x:Name="ListMiniaturas" SelectionChanged="ListMiniaturas_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="4,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="6"
                                                Background="#27272A" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CAF50"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#81C784"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="70" Height="70">
                                <Image Source="{Binding RutaArchivoLocal}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="LowQuality"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Barra inferior con datos de la foto y acciones -->
        <Border Grid.Row="3" Background="#27272A" Padding="16,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="💾 Guardar foto..." Click="BtnGuardar_Click"
                            Background="#3F3F46" BorderThickness="0" Foreground="#E4E4E7"
                            Padding="12,5" Cursor="Hand" FontSize="11.5" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="🖥️ Abrir en visor externo" Click="BtnVisorExterno_Click"
                            Background="#3F3F46" BorderThickness="0" Foreground="#E4E4E7"
                            Padding="12,5" Cursor="Hand" FontSize="11.5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtContador" Text="Foto 1 de 1" FontWeight="SemiBold" FontSize="12.5" Foreground="#F4F4F5"/>
                    <TextBlock x:Name="TxtInfoFoto" Text="Nombre: 1.jpg • Tamaño: 412 KB" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

